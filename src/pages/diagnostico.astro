    <script define:vars={{ PERGUNTAS, DIMENSOES }}>
      function nivelDe(score) {
        if (score < 1) return "Inicial";
        if (score < 2) return "Básico";
        if (score < 3) return "Em desenvolvimento";
        if (score < 3.5) return "Consolidado";
        return "Avançado / Integrado";
      }
      function prioridadeDe(score) {
        if (score < 2) return "Alta";
        if (score < 3) return "Média";
        return "Baixa";
      }

      const state = {
        interesse: null,
        perguntasAtivas: [],
        indice: -1,
        respostas: [],
      };

      // "PACCE" -> só perguntas da trilha pacce. "Serviços" -> só servicos.
      // "PACCE + Serviços" -> as duas trilhas, sem repetir pergunta nenhuma
      // (nenhuma pergunta pertence às duas trilhas ao mesmo tempo).
      function perguntasDaTrilha(interesse) {
        if (interesse === "PACCE") return PERGUNTAS.filter((p) => p.trilha === "pacce");
        if (interesse === "Serviços") return PERGUNTAS.filter((p) => p.trilha === "servicos");
        return PERGUNTAS;
      }

      const stepInteresse = document.getElementById("step-interesse");
      const stepPerguntas = document.getElementById("step-perguntas");
      const stepResultado = document.getElementById("step-resultado");

      // Etapa 0
      document.querySelectorAll(".interesse-card").forEach((card) => {
        card.addEventListener("click", () => {
          state.interesse = card.dataset.interesse;
          state.perguntasAtivas = perguntasDaTrilha(state.interesse);
          state.respostas = new Array(state.perguntasAtivas.length).fill(null);
          document.querySelectorAll(".interesse-card").forEach((c) => c.classList.remove("is-selected"));
          card.classList.add("is-selected");
          stepInteresse.hidden = true;
          stepPerguntas.hidden = false;
          state.indice = 0;
          renderPergunta();
          stepPerguntas.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      // Etapa 1 — uma pergunta por vez
      const elProgressFill = document.getElementById("diag-progress-fill");
      const elProgressLabel = document.getElementById("diag-progress-label");
      const elDimensaoAtual = document.getElementById("diag-dimensao-atual");
      const elPerguntaAtual = document.getElementById("diag-pergunta-atual");
      const elOpcoes = document.getElementById("diag-opcoes");
      const elVoltar = document.getElementById("diag-voltar");

      function renderPergunta() {
        const p = state.perguntasAtivas[state.indice];
        const total = state.perguntasAtivas.length;
        elProgressFill.style.width = `${((state.indice) / total) * 100}%`;
        elProgressLabel.textContent = `Pergunta ${state.indice + 1} de ${total}`;
        elDimensaoAtual.textContent = DIMENSOES[p.dimensao].nome;
        elPerguntaAtual.textContent = p.texto;
        elVoltar.textContent = state.indice === 0 ? "← Trocar o que estou buscando" : "← Voltar";

        elOpcoes.innerHTML = "";
        p.opcoes.forEach((texto, i) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "diag-opcao";
          if (state.respostas[state.indice] === i) btn.classList.add("is-selected");
          btn.innerHTML = `<span class="diag-opcao-n">${i}</span><span>${texto}</span>`;
          btn.addEventListener("click", () => {
            state.respostas[state.indice] = i;
            avancar();
          });
          elOpcoes.appendChild(btn);
        });
      }

      function avancar() {
        if (state.indice < state.perguntasAtivas.length - 1) {
          state.indice += 1;
          renderPergunta();
        } else {
          elProgressFill.style.width = "100%";
          calcularEExibirResultado();
          stepPerguntas.hidden = true;
          stepResultado.hidden = false;
          stepResultado.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      elVoltar.addEventListener("click", () => {
        if (state.indice > 0) {
          state.indice -= 1;
          renderPergunta();
          return;
        }
        // Na primeira pergunta, "Voltar" leva de volta pra escolha PACCE/
        // Serviços/Ambos, caso a pessoa tenha clicado na caixinha errada.
        stepPerguntas.hidden = true;
        stepInteresse.hidden = false;
        document.querySelectorAll(".interesse-card").forEach((c) => c.classList.remove("is-selected"));
        stepInteresse.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      // Etapa 2 — cálculo e exibição
      let resultadoCalculado = null;

      function calcularEExibirResultado() {
        let somaDig = 0, pesoDig = 0, somaProc = 0, pesoProc = 0;
        const porDimensao = {};

        state.perguntasAtivas.forEach((p, i) => {
          const score = state.respostas[i];
          somaDig += score * p.pesoDig;
          pesoDig += p.pesoDig;
          somaProc += score * p.pesoProc;
          pesoProc += p.pesoProc;

          if (!porDimensao[p.dimensao]) porDimensao[p.dimensao] = { soma: 0, peso: 0 };
          const pesoCombinado = p.pesoDig + p.pesoProc;
          porDimensao[p.dimensao].soma += score * pesoCombinado;
          porDimensao[p.dimensao].peso += pesoCombinado;
        });

        const maturidadeDigital = pesoDig ? somaDig / pesoDig : 0;
        const controleProcessos = pesoProc ? somaProc / pesoProc : 0;
        const indiceGeral = (maturidadeDigital + controleProcessos) / 2;

        // Só dimensões com pelo menos 1 pergunta respondida nesta trilha —
        // sem isso, uma dimensão nunca perguntada apareceria com score 0
        // (falsa prioridade "Alta").
        const dimensoesResultado = Object.keys(porDimensao).map((key) => {
          const d = porDimensao[key];
          const score = d.peso ? d.soma / d.peso : 0;
          return { key, nome: DIMENSOES[key].nome, ofertas: DIMENSOES[key].ofertas, score, nivel: nivelDe(score), prioridade: prioridadeDe(score) };
        });
        dimensoesResultado.sort((a, b) => a.score - b.score);

        resultadoCalculado = { maturidadeDigital, controleProcessos, indiceGeral, dimensoesResultado };

        document.getElementById("score-geral").textContent = indiceGeral.toFixed(2);
        document.getElementById("nivel-geral").textContent = nivelDe(indiceGeral);
        document.getElementById("score-digital").textContent = maturidadeDigital.toFixed(2);
        document.getElementById("nivel-digital").textContent = nivelDe(maturidadeDigital);
        document.getElementById("score-processos").textContent = controleProcessos.toFixed(2);
        document.getElementById("nivel-processos").textContent = nivelDe(controleProcessos);

        const listEl = document.getElementById("dim-resultado-list");
        listEl.innerHTML = "";
        dimensoesResultado.forEach((d) => {
          const row = document.createElement("div");
          row.className = "dim-resultado-row";
          row.innerHTML = `
            <div class="dim-resultado-nome">${d.nome}</div>
            <div class="dim-resultado-score">${d.score.toFixed(2)}</div>
            <div class="dim-resultado-nivel">${d.nivel}</div>
            <span class="dim-resultado-prioridade prioridade-${d.prioridade.toLowerCase()}">${d.prioridade}</span>
          `;
          listEl.appendChild(row);
        });

        const lacunas = dimensoesResultado.filter((d) => d.prioridade === "Alta").slice(0, 3);
        const baseLacunas = lacunas.length ? lacunas : dimensoesResultado.slice(0, 2);
        const ofertasSugeridas = new Set();
        baseLacunas.forEach((d) => d.ofertas.forEach((o) => ofertasSugeridas.add(o)));

        const nomesLacunas = baseLacunas.map((d) => d.nome).join(", ");
        document.getElementById("recomendacao-texto").textContent = lacunas.length
          ? `As maiores lacunas hoje estão em ${nomesLacunas}. É por aí que a gente começaria.`
          : `Sua organização já está num bom patamar — ${nomesLacunas} são as frentes com mais espaço pra evoluir.`;

        const chipsEl = document.getElementById("recomendacao-chips");
        chipsEl.innerHTML = "";
        ofertasSugeridas.forEach((nome) => {
          const chip = document.createElement("span");
          chip.className = "recomendacao-chip";
          chip.textContent = nome;
          chipsEl.appendChild(chip);
        });
      }

      // Etapa 2 — captura de contato
      const contatoForm = document.getElementById("diag-contato-form");
      const contatoStatus = document.getElementById("diag-contato-status");
      const contatoSubmit = document.getElementById("diag-contato-submit");

      contatoForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const email = contatoForm.email.value.trim();
        const whatsapp = contatoForm.whatsapp.value.trim();
        if (!email && !whatsapp) {
          contatoStatus.textContent = "Precisamos de pelo menos um e-mail ou WhatsApp pra poder te responder.";
          contatoStatus.className = "form-note is-error";
          return;
        }

        contatoSubmit.disabled = true;
        contatoStatus.textContent = "Enviando...";
        contatoStatus.className = "form-note";

        const r = resultadoCalculado;
        const lacunas = r.dimensoesResultado
          .filter((d) => d.prioridade === "Alta")
          .map((d) => `${d.nome} (${d.score.toFixed(2)})`)
          .join("; ");

        const respostas = state.perguntasAtivas
          .map((p, i) => `${p.texto} → ${p.opcoes[state.respostas[i]]}`)
          .join("\n");

        const formData = new FormData(contatoForm);
        formData.set("interesse", state.interesse || "");
        formData.set("indice_geral", r.indiceGeral.toFixed(2));
        formData.set("maturidade_digital", r.maturidadeDigital.toFixed(2));
        formData.set("controle_processos", r.controleProcessos.toFixed(2));
        formData.set("nivel", nivelDe(r.indiceGeral));
        formData.set("lacunas", lacunas);
        formData.set("respostas", respostas);

        try {
          const resp = await fetch("/assessment/leads/diagnostico", { method: "POST", body: formData });
          if (!resp.ok) throw new Error(`status ${resp.status}`);
          contatoForm.reset();
          contatoForm.hidden = true;
          contatoStatus.textContent = "Recebemos seu diagnóstico — a gente entra em contato em breve. Obrigado!";
          contatoStatus.className = "form-note is-ok";
        } catch (err) {
          contatoStatus.textContent = "Não foi possível enviar agora. Tente de novo em instantes.";
          contatoStatus.className = "form-note is-error";
        } finally {
          contatoSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Diagnóstico no padrão full-bleed editorial da v2, em fundo preto do
     topo ao rodapé (pedido do Ricardo, 2026-10-05). Mesmas fontes e
     vermelho da home; os nomes de token seguem os do global.css. */
  :root {
    --bg: #111110;
    --bg-alt: #1b1b19;
    --card: #1d1d1b;
    --ink: #f5f4f1;
    --ink-soft: #a9a8a2;
    --line: #34332f;
    --accent: #e0201a;
    --accent-claro: #ff8a84;
    --accent-ink: #fff3f2;
    --support: #93b399;
    --support-tint: #1e2a1f;
    --ease: cubic-bezier(.16, 1, .3, 1);
  }
  html, body { background: var(--bg); }
  body { color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  h1, h2, h3 { font-family: var(--font-title); letter-spacing: -0.015em; text-wrap: balance; margin: 0; }
  p { text-wrap: pretty; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.4rem; }
  .wrap.estreito { max-width: 820px; }
  .destaque { color: var(--accent-claro); }
  .lede { font-size: 1.05rem; color: var(--ink-soft); max-width: 62ch; margin: 0 0 1.2rem; }

  /* Topo */
  .topo { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1.4rem; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .marca { font-family: var(--font-title); font-weight: 800; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .marca span { font-weight: 500; color: var(--ink-soft); }
  .menu { display: flex; gap: 1.5rem; font-size: .9rem; font-weight: 600; }
  .menu a { text-decoration: none; color: var(--ink-soft); }
  .menu a:hover { color: var(--accent-claro); }
  @media (max-width: 640px) { .menu { gap: 1rem; font-size: .82rem; } .menu a:first-child { display: none; } }

  /* Botões */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; border-radius: 999px; padding: .9rem 1.6rem; font-family: var(--font-title); font-weight: 700; font-size: .95rem; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: transform .3s var(--ease), background .2s ease, border-color .2s ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover { background: #b8160f; }
  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .btn-ghost:hover { border-color: var(--ink-soft); }
  :focus-visible { outline: 2px solid var(--accent-claro); outline-offset: 3px; }

  /* Hero full-bleed */
  .hero { position: relative; min-height: min(78vh, 680px); display: flex; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(0deg, var(--bg) 0%, rgba(17, 17, 16, .82) 38%, rgba(17, 17, 16, .45) 72%, rgba(17, 17, 16, .25) 100%); }
  .hero-inner { position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding-top: 6rem; padding-bottom: 3rem; }
  .selo { display: inline-block; align-self: flex-start; border: 1px solid rgba(255, 255, 255, .28); border-radius: 999px; padding: .4rem 1rem; font-family: var(--font-title); font-weight: 600; font-size: .85rem; color: rgba(255, 255, 255, .85); margin: 0 0 1.4rem; }
  .hero h1 { font-size: clamp(2.2rem, 5.4vw, 4.2rem); line-height: 1.04; max-width: 18ch; color: #fff; margin-bottom: 1.2rem; }
  .hero-sub { font-size: 1.1rem; color: rgba(255, 255, 255, .84); max-width: 58ch; margin: 0; }
  .passos-hero { list-style: none; padding: 1.3rem 0 0; margin: 2.4rem 0 0; display: flex; flex-wrap: wrap; gap: .8rem 2.2rem; border-top: 1px solid rgba(255, 255, 255, .2); max-width: 760px; }
  .passos-hero li { display: flex; align-items: center; gap: .7rem; font-weight: 600; color: #fff; }
  .passos-hero b { width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-family: var(--font-title); font-size: .9rem; }

  main { padding-bottom: 5rem; }
  .diag-step { padding-top: 3.5rem; scroll-margin-top: 4.5rem; }
  .etapa-cabeca { margin-bottom: 2rem; }
  .etapa-cabeca h2 { font-size: clamp(1.9rem, 3.8vw, 2.9rem); line-height: 1.08; margin-bottom: .9rem; }

  /* Caixinhas: painéis com foto em largura total */
  .interesse-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .interesse-card { position: relative; display: flex; align-items: flex-end; min-height: clamp(420px, 62vh, 600px); padding: 0; margin: 0; border: 0; border-left: 1px solid var(--line); background: #000; color: #fff; text-align: left; cursor: pointer; overflow: hidden; font: inherit; isolation: isolate; }
  .interesse-card:first-child { border-left: 0; }
  .interesse-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .62; filter: grayscale(.3) contrast(1.05); transition: transform 1.1s var(--ease), opacity .5s ease, filter .5s ease; z-index: -2; }
  .interesse-card::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(10, 10, 9, .97) 0%, rgba(10, 10, 9, .78) 45%, rgba(10, 10, 9, .25) 100%); transition: background .5s ease; }
  .interesse-card::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
  .interesse-corpo { display: flex; flex-direction: column; gap: .55rem; padding: clamp(1.6rem, 3vw, 2.6rem); width: 100%; }
  .interesse-tag { font-size: .8rem; font-weight: 600; color: var(--accent-claro); }
  .interesse-titulo { font-family: var(--font-title); font-weight: 700; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.08; letter-spacing: -0.015em; }
  .interesse-desc { font-size: .98rem; color: rgba(255, 255, 255, .84); max-width: 34ch; min-height: 4.8em; }
  .interesse-meta { font-size: .85rem; color: rgba(255, 255, 255, .62); margin-top: .3rem; }
  .interesse-ir { display: inline-flex; align-items: center; gap: .5rem; align-self: flex-start; margin-top: .9rem; font-family: var(--font-title); font-weight: 700; font-size: .95rem; padding: .7rem 1.2rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .45); transition: background .3s ease, border-color .3s ease; }
  .interesse-ir i { font-style: normal; transition: transform .4s var(--ease); }
  .interesse-card:hover img, .interesse-card:focus-visible img { transform: scale(1.06); opacity: .8; filter: none; }
  .interesse-card:hover::after, .interesse-card:focus-visible::after, .interesse-card.is-selected::after { transform: scaleX(1); }
  .interesse-card:hover .interesse-ir, .interesse-card:focus-visible .interesse-ir, .interesse-card.is-selected .interesse-ir { background: var(--accent); border-color: var(--accent); }
  .interesse-card:hover .interesse-ir i { transform: translateX(4px); }
  .interesse-card:focus-visible { outline-offset: -4px; }
  @media (max-width: 860px) {
    .interesse-grid { grid-template-columns: 1fr; }
    .interesse-card { min-height: 360px; border-left: 0; border-top: 1px solid var(--line); }
    .interesse-card:first-child { border-top: 0; }
  }

  /* Perguntas */
  .diag-progress { margin-bottom: 2.4rem; }
  .diag-progress-bar { height: 4px; border-radius: 999px; background: var(--line); overflow: hidden; margin-bottom: .6rem; }
  #diag-progress-fill { height: 100%; background: var(--accent); width: 0%; transition: width .4s var(--ease); }
  #diag-progress-label { font-size: .85rem; color: var(--ink-soft); }
