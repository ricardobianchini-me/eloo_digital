---
// Apresentação comercial da eloo.digital (carrossel full-bleed, 12 slides).
// Institucional: o PACCE aparece como um dos produtos, não como co-marca.
// Página fora do menu e marcada como noindex: link enviado só para prospects.
// Mesmos tokens, fontes e logo da v2 (ver DESIGN.md). Roteiro em
// Agentes/pacce-co/artefatos/Apresentação - eloo.digital.md.
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (nome: string) => `${B}/img/${nome}`;

const problemas = [
  { nome: "Processos manuais", desc: "Horas em tarefas repetidas que uma máquina poderia fazer." },
  { nome: "Sistemas que não conversam", desc: "A mesma informação digitada em vários lugares — e nunca coincide." },
  { nome: "Falta de visibilidade", desc: "O problema aparece quando já chegou ao cliente." },
  { nome: "Conhecimento preso às pessoas", desc: "Quando alguém sai, parte do processo vai junto." },
];

const capacidades = [
  { nome: "Automação de processos", desc: "Workflows, integrações e APIs que eliminam trabalho repetido.", foto: "servico-solucoes.jpg" },
  { nome: "Inteligência artificial aplicada", desc: "Agentes, leitura de documentos, triagem e classificação.", foto: "comp-tecnologia.jpg" },
  { nome: "Software sob medida", desc: "Aplicações, portais e modernização de sistemas legados.", foto: "servico-sites.jpg" },
  { nome: "Dados e assessment de TI", desc: "Dashboards, arquitetura, riscos e roadmap de evolução.", foto: "comp-consultoria.jpg" },
];

const stack = [
  { camada: "Frontend", tec: "React + TypeScript", desc: "Componentes reutilizáveis, telas responsivas, tipos validados." },
  { camada: "Backend", tec: "Go", desc: "Regras no servidor, transações, concorrência e idempotência." },
  { camada: "Dados", tec: "PostgreSQL", desc: "Integridade referencial, constraints e migrations versionadas." },
  { camada: "Entrega", tec: "Docker + CI", desc: "Testes automatizados e gates antes de cada versão." },
];

const casos = [
  { nome: "Empresas e operações", desc: "Rotinas manuais viram fluxos automáticos entre sistemas.", foto: "servico-solucoes.jpg", alt: "Operação organizada em processos" },
  { nome: "Atendimento recorrente", desc: "Plataforma própria organiza cadastro, histórico, filas e escalas.", foto: "pacce-prontuario.jpg", alt: "Ficha de atendimento com histórico" },
  { nome: "Terceiro setor", desc: "Governança e prestação de contas a diretoria e financiadores.", foto: "sobre-acolhimento.jpg", alt: "Conversa de acolhimento entre duas pessoas" },
  { nome: "Assessment de TI", desc: "Processos, sistemas e riscos mapeados, com roadmap priorizado.", foto: "comp-consultoria.jpg", alt: "Reunião de análise com documentos" },
];

// Níveis de suporte por plano (definidos pelos sócios em 2026-10-07).
const planos = [
  { nome: "Ouro", itens: [
    { valor: "24/7", desc: "monitoramento por telemetria e IA" },
    { valor: "9h às 20h", desc: "suporte da equipe" },
    { valor: "até 4h", desc: "para restabelecer um serviço interrompido" },
    { valor: "até 5 dias úteis", desc: "para análise e primeira resposta a requisições" },
  ] },
  { nome: "Diamante", destaque: true, itens: [
    { valor: "24/7", desc: "monitoramento e suporte" },
    { valor: "até 1h", desc: "para restabelecer um serviço interrompido" },
    { valor: "até 2 dias úteis", desc: "para análise e primeira resposta a requisições" },
  ] },
];

// WhatsApp oficial do site: quando definido (só dígitos, com DDI e DDD,
// ex.: "5511999999999"), o botão aparece no slide final.
const WHATSAPP = "";

const TOTAL = 12;
const n = (i: number) => String(i).padStart(2, "0");
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Apresentação — eloo.digital</title>
    <meta name="description" content="Apresentação comercial da eloo.digital." />
    <link rel="icon" type="image/svg+xml" href={`${B}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topo">
      <a href="/" class="marca" aria-label="eloo.digital, página inicial">eloo<span class="ponto">.</span><span>digital</span></a>
      <div class="topo-dir">
        <span class="contador" aria-live="polite"><b id="atual">01</b> / {n(TOTAL)}</span>
        <a href="/diagnostico" class="cta-topo">Fazer o diagnóstico</a>
      </div>
    </header>

    <main class="trilho" id="trilho" tabindex="-1" aria-roledescription="carrossel" aria-label="Apresentação eloo.digital">

      <!-- 01 CAPA -->
      <section class="slide s-capa" id="s1" aria-label="Slide 1 de 12">
        <img class="capa-img" src={img("hero-elo-maos.jpg")} alt="Mãos dadas em círculo, vistas de cima — o elo entre pessoas" />
        <div class="scrim"></div>
        <div class="capa-inner">
          <p class="eyebrow claro">Apresentação comercial</p>
          <h1><span class="logo-grande">eloo<span class="ponto">.</span><span class="sufixo">digital</span></span></h1>
          <p class="sub claro">Tecnologia que tira a operação do improviso e coloca sob controle.</p>
          <ul class="bullets claro">
            <li>Automação, IA e software sob medida para a operação real.</li>
            <li>Produtos próprios por assinatura, prontos para cada segmento.</li>
            <li>Do diagnóstico à operação contínua, com o mesmo time.</li>
          </ul>
          <p class="callout callout-claro">Mais do que software: <strong>previsibilidade e controle.</strong></p>
        </div>
      </section>

      <!-- 02 QUEM SOMOS -->
      <section class="slide s-bleed escuro" id="s2" aria-label="Slide 2 de 12">
        <img class="foto" src={img("metodologia-grupo.jpg")} alt="Roda de conversa — entender antes de propor" loading="lazy" />
        <div class="texto">
          <p class="eyebrow claro">02 · Quem somos</p>
          <h2>Estratégia e execução <span class="destaque">no mesmo time.</span></h2>
          <p class="sub claro">Uma empresa de tecnologia, automação e transformação digital.</p>
          <ul class="bullets claro">
            <li>Arquitetura, governança e desenvolvimento sob o mesmo teto.</li>
            <li>De ponta a ponta: diagnóstico, construção e evolução.</li>
            <li>Metodologia LUMEN: clareza sobre o problema antes da solução.</li>
          </ul>
          <div class="numero">
            <b>25</b>
            <p><strong>anos de jornada em tecnologia</strong>, 7 deles na linha de frente do atendimento.</p>
          </div>
        </div>
      </section>

      <!-- 03 PROBLEMAS -->
      <section class="slide s-bleed s-reverso" id="s3" aria-label="Slide 3 de 12">
        <img class="foto" src={img("pacce-prontuario.jpg")} alt="Ficha de cadastro preenchida à mão — o trabalho manual de hoje" loading="lazy" />
        <div class="texto">
          <p class="eyebrow">03 · O que resolvemos</p>
          <h2>O que trava <span class="destaque-ink">a operação.</span></h2>
          <p class="sub">Crescer acumulando improvisos custa margem, tempo e reputação.</p>
          <ol class="dores">
            {problemas.map((p, i) => (
              <li><span>{n(i + 1)}</span><div><b>{p.nome}</b><small>{p.desc}</small></div></li>
            ))}
          </ol>
          <p class="callout">Tecnologia não deveria criar <strong>mais trabalho.</strong></p>
        </div>
      </section>

      <!-- 04 O QUE OFERECEMOS -->
      <section class="slide s-grade" id="s4" aria-label="Slide 4 de 12">
        <div class="grade-inner">
          <div class="grade-cabeca">
            <p class="eyebrow">04 · O que oferecemos</p>
            <h2>Capacidades certas <span class="destaque-ink">para o problema certo.</span></h2>
            <p class="sub">Combinamos as frentes que a sua operação precisa — nem mais, nem menos.</p>
          </div>
          <div class="cards">
            {capacidades.map((c, i) => (
              <article class="card">
                <div class="card-img"><img src={img(c.foto)} alt="" loading="lazy" /><span class="num">{n(i + 1)}</span></div>
                <div class="card-corpo"><h3>{c.nome}</h3><p>{c.desc}</p></div>
              </article>
            ))}
          </div>
          <p class="callout">Serviços sob demanda e <strong>produtos por assinatura</strong> — começa onde você está.</p>
        </div>
      </section>

      <!-- 05 PRODUTOS -->
      <section class="slide s-produto escuro" id="s5" aria-label="Slide 5 de 12">
        <div class="produto-grid">
          <div class="texto-solto">
            <p class="eyebrow claro">05 · Produtos eloo.digital</p>
            <h2>Produtos próprios, <span class="destaque">prontos para operar.</span></h2>
            <p class="sub claro">Plataformas por assinatura, com a mesma engenharia, segurança e suporte.</p>
            <ul class="bullets claro">
              <li>Base comum: acesso por perfil, auditoria, isolamento de dados e LGPD.</li>
              <li>Adaptados a cada segmento, sem começar do zero.</li>
              <li>Planos Ouro e Diamante, com níveis de suporte definidos.</li>
            </ul>
            <ul class="linha-produtos" aria-label="Linha de produtos">
              <li><b>PACCE</b><span>Gestão de atendimento recorrente</span><em>Em produção</em></li>
              <li><b>Novos produtos</b><span>Versões para outros segmentos</span><em class="em-breve">Em preparação</em></li>
            </ul>
            <p class="callout callout-claro">Produto pronto quando serve; <strong>sob medida quando precisa.</strong></p>
          </div>
          <figure class="tela">
            <div class="tela-barra" aria-hidden="true"><i></i><i></i><i></i><span>produto eloo.digital</span></div>
            <img src={img("pacce-exemplo.svg")} alt="Tela de um produto eloo.digital (PACCE) com dados de exemplo" loading="lazy" />
            <figcaption>PACCE, o primeiro da linha. Tela com dados de exemplo.</figcaption>
          </figure>
        </div>
      </section>

      <!-- 06 SUPORTE -->
      <section class="slide s-faixa vermelho" id="s6" aria-label="Slide 6 de 12">
        <div class="faixa-inner">
          <div class="faixa-texto">
            <p class="eyebrow claro-red">06 · Suporte e operação contínua</p>
            <h2>Suporte que <span class="branco">não dorme.</span></h2>
            <p class="sub">Monitoramento 24/7 em todos os planos e prazos de atendimento definidos.</p>
            <ul class="bullets">
              <li>Telemetria e agentes de IA monitorando os produtos o tempo todo.</li>
              <li>Falhas corrigidas automaticamente (<em>self-healing</em>), com a equipe acompanhando de perto.</li>
              <li>Falhas e pedidos registrados direto pelo site.</li>
            </ul>
          </div>
          <div class="planos">
            {planos.map((p) => (
              <article class={`plano ${p.destaque ? "plano-destaque" : ""}`}>
                <h3>Plano {p.nome}</h3>
                <dl>
                  {p.itens.map((it) => <div><dt>{it.valor}</dt><dd>{it.desc}</dd></div>)}
                </dl>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 07 ARQUITETURA -->
      <section class="slide s-faixa escuro" id="s7" aria-label="Slide 7 de 12">
        <div class="faixa-inner">
          <div class="faixa-texto">
            <p class="eyebrow claro">07 · Arquitetura e tecnologia</p>
            <h2>Engenharia para <span class="destaque">operação real.</span></h2>
            <p class="sub claro">Arquitetura moderna, modular e pronta para evoluir.</p>
            <ul class="bullets claro">
              <li>Interface, regras, dados, autenticação e infraestrutura separados.</li>
              <li>Regras de negócio executadas no servidor, nunca só na tela.</li>
              <li>Cada mudança versionada e rastreável.</li>
            </ul>
            <p class="callout callout-claro">Nenhuma versão sai <strong>sem passar pela esteira de validação.</strong></p>
          </div>
          <ul class="stack" aria-label="Stack tecnológica">
            {stack.map((s) => (
              <li><span>{s.camada}</span><b>{s.tec}</b><small>{s.desc}</small></li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 08 SEGURANÇA -->
      <section class="slide s-bleed" id="s8" aria-label="Slide 8 de 12">
        <div class="foto-tela">
          <figure class="tela tela-clara">
            <div class="tela-barra" aria-hidden="true"><i></i><i></i><i></i><span>produto eloo.digital · perfis de acesso</span></div>
            <img src={img("pacce-perfis-acesso.jpg")} alt="Tela de perfis de acesso de um produto eloo.digital: Admin Master, Dirigente, Operador e Colaborador" loading="lazy" />
          </figure>
        </div>
        <div class="texto">
          <p class="eyebrow">08 · Segurança e DevSecOps</p>
          <h2>Segurança <span class="destaque-ink">por arquitetura.</span></h2>
          <p class="sub">Não é uma camada adicionada no fim — nasce no desenho.</p>
          <ul class="bullets">
            <li>Isolamento entre instituições validado no backend, com testes negativos.</li>
            <li>Acesso por perfil, permissão e papel, checado no servidor.</li>
            <li>Sessões revogáveis e trilha de auditoria: quem, quando, o quê.</li>
            <li>IA na revisão de código e em cenários de ataque — aceita só com teste reproduzível.</li>
          </ul>
          <p class="callout">Testes que <strong>provam que a proteção funciona</strong> — e acusam se ela sumir.</p>
        </div>
      </section>

      <!-- 09 LGPD -->
      <section class="slide s-bleed s-reverso escuro" id="s9" aria-label="Slide 9 de 12">
        <img class="foto" src={img("pacce-seguranca.jpg")} alt="Pessoa trabalhando com atenção em informações protegidas" loading="lazy" />
        <div class="texto">
          <p class="eyebrow claro">09 · Conformidade e LGPD</p>
          <h2>Privacidade <span class="destaque">desde o cadastro.</span></h2>
          <p class="sub claro">LGPD tratada como requisito de produto, não como anexo.</p>
          <ul class="bullets claro">
            <li>Consentimento do atendido registrado no próprio cadastro.</li>
            <li>Dados de cada instituição isolados; cada pessoa vê só o que o perfil permite.</li>
            <li>Senhas, tokens e códigos nunca entram nos registros de auditoria.</li>
            <li>Avaliação de impacto à privacidade feita sobre o fluxo de atendimento.</li>
          </ul>
          <p class="callout callout-claro"><em>Privacy by design</em>: <strong>menos risco jurídico e reputacional.</strong></p>
        </div>
      </section>

      <!-- 10 CASOS DE USO -->
      <section class="slide s-grade" id="s10" aria-label="Slide 10 de 12">
        <div class="grade-inner">
          <div class="grade-cabeca">
            <p class="eyebrow">10 · Casos de uso</p>
            <h2>Onde geramos <span class="destaque-ink">valor.</span></h2>
            <p class="sub">A mesma capacidade, aplicada a contextos diferentes.</p>
          </div>
          <div class="cards">
            {casos.map((c, i) => (
              <article class="card">
                <div class="card-img"><img src={img(c.foto)} alt={c.alt} loading="lazy" /><span class="num">{n(i + 1)}</span></div>
                <div class="card-corpo"><h3>{c.nome}</h3><p>{c.desc}</p></div>
              </article>
            ))}
          </div>
          <p class="callout">Antes: e-mail, planilha e cópia. <strong>Depois: evento, regra e indicador.</strong></p>
        </div>
      </section>

      <!-- 11 DIAGNÓSTICO -->
      <section class="slide s-bleed" id="s11" aria-label="Slide 11 de 12">
        <img class="foto" src={img("diagnostico-analise-noturna.jpg")} alt="Análise de indicadores da operação com atenção aos detalhes" loading="lazy" />
        <div class="texto">
          <p class="eyebrow">11 · O primeiro passo</p>
          <p class="tempo">≈ 3 minutos</p>
          <h2>Comece pelo <span class="destaque-ink">diagnóstico.</span></h2>
          <p class="sub">Descubra onde a tecnologia gera mais impacto na sua operação.</p>
          <ul class="bullets">
            <li>Perguntas objetivas sobre como sua organização trabalha hoje.</li>
            <li>Leitura das frentes com maior aderência ao seu cenário.</li>
            <li>Nosso time retorna com a análise e os ganhos rápidos.</li>
          </ul>
          <p class="callout">Sem custo e <strong>sem compromisso.</strong></p>
          <div class="acoes"><a class="btn btn-primario" href="/diagnostico">Começar o diagnóstico ↗</a></div>
        </div>
      </section>

      <!-- 12 ENCERRAMENTO -->
      <section class="slide s-capa s-final" id="s12" aria-label="Slide 12 de 12">
        <img class="capa-img" src={img("comp-fluencia.jpg")} alt="Conversa entre duas pessoas — o próximo passo começa com uma conversa" loading="lazy" />
        <div class="scrim"></div>
        <div class="capa-inner">
          <p class="eyebrow claro">12 · Próximos passos</p>
          <h2>Qual processo você quer que funcione <span class="destaque">melhor amanhã?</span></h2>
          <ul class="bullets claro">
            <li>Faça o diagnóstico: <strong>eloo.digital/diagnostico</strong></li>
            <li>Conheça nossos serviços e produtos: <strong>eloo.digital</strong></li>
            <li>Converse com nosso time e veja a solução aplicada à sua operação.</li>
          </ul>
          <p class="callout callout-claro">Conte o problema. <strong>A tecnologia vem depois.</strong></p>
          <div class="acoes">
            <a class="btn btn-primario" href="/diagnostico">Agendar meu diagnóstico ↗</a>
            {WHATSAPP && <a class="btn btn-ghost" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener">Falar no WhatsApp ↗</a>}
            <a class="btn btn-ghost" href="/">Conhecer a eloo.digital</a>
          </div>
        </div>
      </section>
    </main>

    <nav class="controles" aria-label="Navegação dos slides">
      <button class="seta" id="ant" aria-label="Slide anterior">←</button>
      <ol class="pontos" id="pontos">
        {Array.from({ length: TOTAL }, (_, i) => (
          <li><button data-ir={i} aria-label={`Ir para o slide ${i + 1}`}></button></li>
        ))}
      </ol>
      <button class="seta" id="prox" aria-label="Próximo slide">→</button>
    </nav>
    <div class="progresso" aria-hidden="true"><span id="barra"></span></div>

    <script is:inline>
      const trilho = document.getElementById("trilho");
      const slides = [...trilho.querySelectorAll(".slide")];
      const pontos = [...document.querySelectorAll("#pontos button")];
      const atual = document.getElementById("atual");
      const barra = document.getElementById("barra");
      let idx = 0;

      const ir = (i, suave = true) => {
        i = Math.max(0, Math.min(slides.length - 1, i));
        trilho.scrollTo({ left: i * trilho.clientWidth, behavior: suave ? "smooth" : "auto" });
      };
      const marcar = (i) => {
        if (i === idx && atual.textContent) return;
        idx = i;
        atual.textContent = String(i + 1).padStart(2, "0");
        barra.style.width = `${((i + 1) / slides.length) * 100}%`;
        pontos.forEach((p, k) => p.setAttribute("aria-current", k === i ? "true" : "false"));
        history.replaceState(null, "", `#${i + 1}`);
      };

      trilho.addEventListener("scroll", () => {
        marcar(Math.round(trilho.scrollLeft / trilho.clientWidth));
      }, { passive: true });
      document.getElementById("ant").addEventListener("click", () => ir(idx - 1));
      document.getElementById("prox").addEventListener("click", () => ir(idx + 1));
      pontos.forEach((p) => p.addEventListener("click", () => ir(Number(p.dataset.ir))));

      document.addEventListener("keydown", (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        if (["ArrowRight", "PageDown", " "].includes(e.key)) { e.preventDefault(); ir(idx + 1); }
        else if (["ArrowLeft", "PageUp"].includes(e.key)) { e.preventDefault(); ir(idx - 1); }
        else if (e.key === "Home") { e.preventDefault(); ir(0); }
        else if (e.key === "End") { e.preventDefault(); ir(slides.length - 1); }
      });
      // Mantém o slide atual alinhado ao redimensionar a janela.
      window.addEventListener("resize", () => ir(idx, false));

      const inicial = parseInt(location.hash.slice(1), 10);
      atual.textContent = "";
      if (inicial > 1) ir(inicial - 1, false);
      marcar(Number.isFinite(inicial) && inicial > 1 ? inicial - 1 : 0);
      trilho.focus({ preventScroll: true });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #f4f2ed;
    --bg-alt: #e6e4dd;
    --card: #fbfaf7;
    --ink: #1f1f1d;
    --ink-soft: #55554f;
    --line: #d8d6ce;
    --accent: #e0201a;
    --accent-deep: #b8160f;
    --accent-ink: #fff3f2;
    --font-title: 'Bricolage Grotesque', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --topo: 64px;
    --base: 72px;
    --ease: cubic-bezier(.16,1,.3,1);
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body { margin: 0; background: var(--ink); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.55; overflow: hidden; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--font-title); letter-spacing: -0.01em; text-wrap: balance; margin: 0; }
  p { margin: 0; }

  /* Topo e controles fixos */
  .topo { position: fixed; top: 0; left: 0; right: 0; height: var(--topo); z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.4rem; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .marca { font-family: var(--font-title); font-weight: 800; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .marca span { font-weight: 500; color: var(--ink-soft); }
  .marca .ponto, .logo-grande .ponto { color: var(--accent); font-weight: 800; }
  .topo-dir { display: flex; align-items: center; gap: 1.2rem; }
  .contador { font-family: var(--font-title); font-size: .9rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
