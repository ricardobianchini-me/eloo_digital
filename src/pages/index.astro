---
import '../styles/global.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';

const DIAGNOSTICO_URL = "https://claude.ai/code/artifact/1015379a-794c-4a92-8e04-ea01320f4fab";
const PACCE_URL = "https://pacce.app";

const ofertas = [
  { tag: "Produto", nome: "PACCE", desc: "Plataforma de gestão e atendimento — o núcleo de tudo.", core: true },
  { tag: "Serviço", nome: "Criação de Sites", desc: "Institucional com CMS — manutenção contínua, não entrega única." },
  { tag: "Serviço", nome: "Marketing Digital", desc: "Conteúdo e captação com fluência no seu público." },
  { tag: "Serviço", nome: "Canais Digitais", desc: "Facebook, Instagram e YouTube publicados pelo mesmo motor do PACCE." },
];

const jornada = [
  {
    n: "01", nome: "Diagnóstico",
    resumo: "Uma avaliação rápida e precisa do seu cenário atual.",
    como: "Uma conversa de 20 minutos ou um questionário rápido avaliando 6 dimensões estratégicas.",
    recebe: "Um relatório completo em até 24 horas.",
    status: "live",
  },
  {
    n: "02", nome: "Planejamento",
    resumo: "O caminho estratégico para a evolução da sua entidade.",
    como: "Criamos um plano de implantação sob medida, respeitando o ritmo e a realidade da sua organização a partir dos resultados do diagnóstico.",
    status: "pending",
  },
  {
    n: "03", nome: "Implantação",
    resumo: "A tecnologia e o método saindo do papel.",
    como: "Execução 100% acompanhada pelo nosso time para a implementação do site, do sistema (PACCE) ou de ambos.",
    status: "pending",
  },
  {
    n: "04", nome: "Evolução",
    resumo: "A parceria de longo prazo que garante a continuidade.",
    como: "Acompanhamento recorrente e suporte pós-implantação. A gente não some após a entrega — cresce junto com você.",
    status: "pending",
  },
];

const dimensoes = [
  { nome: "Cadastro e Pré-cadastro", desc: "Como as informações de quem é atendido são coletadas e guardadas." },
  { nome: "Acompanhamento do Atendimento", desc: "O histórico e a evolução de cada assistido." },
  { nome: "Escalas de Trabalhadores", desc: "A organização dos turnos de funcionários e voluntários." },
  { nome: "Presença Digital", desc: "Como sua organização se posiciona e se comunica na internet." },
  { nome: "Ferramenta Atual", desc: "A avaliação dos sistemas ou métodos que você já usa hoje." },
  { nome: "Transparência Financeira", desc: "A organização dos dados para facilitar prestações de contas em assembleia." },
];

const maturidade = [
  { n: "1", nome: "Manual", desc: "Processos dependentes de papel, memória ou conversas de WhatsApp sem centralização." },
  { n: "2", nome: "Parcial", desc: "Uso de planilhas ou documentos isolados, sem garantia de continuidade das informações." },
  { n: "3", nome: "Frágil", desc: "Existe um sistema em uso, mas sofre com falta de atualização, lentidão ou ausência de suporte." },
  { n: "4", nome: "Estruturado", desc: "Processo digital seguro, com continuidade garantida, independente de quem o opere." },
];

const servicos = [
  {
    nome: "Sites Institucionais Inteligentes (com CMS)",
    desc: "Presença digital forte e sob controle. Cuidamos do design, da tecnologia e da manutenção contínua pós-entrega — uma parceria de longo prazo para garantir que seu site cresça junto com a sua causa.",
  },
  {
    nome: "Marketing Digital e Captação Estratégica",
    desc: "Fluência real no seu nicho para atrair quem importa. Criamos conteúdos autênticos, eliminando textos genéricos e robóticos, garantindo uma comunicação que gera identificação e confiança imediatas.",
  },
  {
    nome: "Sincronização de Canais Digitais",
    desc: "Suas redes sociais integradas ao seu sistema de gestão. Publique e atualize seus conteúdos no Instagram, Facebook e YouTube a partir de um único lugar, sem depender de voluntário disponível.",
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>eloo.digital — Feito para durar</title>
    <meta
      name="description"
      content="Cadastro, atendimento e presença digital para entidades de acolhimento e organizações do terceiro setor. A eloo.digital é o parceiro de tecnologia que essas instituições sempre precisaram."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
  </head>
  <body>
    <nav>
      <a href="#topo" class="wordmark nav-wordmark" aria-label="eloo.digital, início">el<span class="oo">oo</span><span class="dot">.</span><span class="suffix">digital</span></a>
      <div class="navlinks">
        <a href="#sobre">Sobre</a>
        <a href="#metodologia">Metodologia</a>
        <a href="/pacce">PACCE</a>
        <a href="#servicos">Serviços</a>
        <a href="#contato">Contato</a>
      </div>
      <a class="btn btn-nav" href={DIAGNOSTICO_URL}>Faça o diagnóstico gratuito</a>
    </nav>

    <header class="hero reveal" id="topo">
      <div class="hero-inner">
        <span class="badge">Sete anos de campo no acolhimento e na assistência social, hoje a serviço de qualquer organização do terceiro setor</span>
        <h1>O nível de parceria em tecnologia que a sua organização <span class="accent">nunca experimentou</span>.</h1>
        <p class="hero-sub">
          O parceiro na sua transformação digital — o seu <em>elo</em> com o mundo digital, em
          gestão, presença e marketing. Mais do que um fornecedor que some após a entrega, somos o
          parceiro estratégico que cresce junto com o seu negócio.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={DIAGNOSTICO_URL}>Faça o diagnóstico gratuito</a>
          <a class="btn btn-ghost" href="/pacce">Conhecer o PACCE</a>
        </div>
      </div>
    </header>

    <section class="section" id="hub">
      <p class="eyebrow">O que a eloo.digital faz por você</p>
      <h2>Entregamos uma solução completa, sustentada por três serviços de apoio.</h2>
      <p class="lede">
        Por trás de tudo isso está a eloo.digital: uma parceira única, com o mesmo time e o mesmo
        cuidado de longo prazo, pronta para atender o desafio mais urgente da sua organização.
      </p>

      <div class="hub-grid">
        {ofertas.map((o) => (
          <div class={`hub-card ${o.core ? "hub-card-core" : ""}`}>
            <span class="hub-tag">{o.tag}</span>
            <h3>{o.nome}</h3>
            <p>{o.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="sobre">
      <div class="sobre-grid">
        <div>
          <p class="eyebrow">Sobre a eloo.digital</p>
          <h2>O parceiro estratégico em tecnologia que a sua organização sempre precisou</h2>
          <p class="lede">
            Conectamos propósito e inovação para ampliar o alcance do bem. Não somos uma agência
            comum e nem apenas uma empresa de software — unimos tecnologia de ponta e IA aplicada
            a um método de consultoria estratégica.
          </p>
          <p class="lede">
            Mais do que isso: temos fluência real na rotina, na cultura e na linguagem de quem
            atua na linha de frente do acolhimento e da assistência social.
          </p>
          <p class="eyebrow" style="margin-top:2rem;">Para quem trabalhamos</p>
          <p class="lede">
            Apoiamos organizações do Terceiro Setor que possuem uma estrutura sólida, governança
            formal e o compromisso transparente de prestação de contas. Nosso foco é fortalecer:
          </p>
          <div class="pills">
            <span class="pill">Entidades de Acolhimento</span>
            <span class="pill">Organizações Assistenciais</span>
            <span class="pill">Projetos e Associações Sociais</span>
          </div>
        </div>
        <div class="comp-list">
          <div class="comp-card">
            <h4>Tecnologia e Inteligência Artificial Aplicadas</h4>
            <p>Tecnologia real, validada e pronta para o mercado. O PACCE não é uma promessa de futuro: ele já opera em produção e entrega resultados hoje.</p>
          </div>
          <div class="comp-card">
            <h4>Consultoria Estratégica e Direcionada</h4>
            <p>Entender primeiro, propor depois. Através da Metodologia LUMEN, realizamos um diagnóstico preciso para garantir que a tecnologia atenda às reais necessidades do seu negócio.</p>
          </div>
          <div class="comp-card">
            <h4>Fluência Real na Linguagem do Terceiro Setor</h4>
            <p>São 7 anos de experiência de campo aplicados ao seu projeto. Falamos a mesma língua e entregamos soluções sob medida para quem atua no acolhimento e na assistência.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section band" id="metodologia">
      <p class="eyebrow">Como trabalhamos</p>
      <h2>Metodologia LUMEN — o que avaliamos antes de propor qualquer solução</h2>
      <p class="lede">
        A Metodologia LUMEN nasceu de 7 anos de vivência real na linha de frente de entidades de
        acolhimento. Ela não é um modelo teórico ou genérico copiado do mercado corporativo
        tradicional — desenvolvemos um método estruturado de <strong>Maturidade Digital</strong>
        desenhado sob medida para as necessidades e dores específicas do atendimento assistencial
        e do terceiro setor.
      </p>

      <p class="eyebrow" style="margin-top:3rem;">A jornada da sua organização</p>
      <p class="lede">Dividida em quatro etapas claras, focadas em dar segurança e previsibilidade pra sua diretoria:</p>

      <div class="jornada-grid">
        {jornada.map((j) => (
          <div class={`j-step j-step-${j.status}`}>
            <p class="j-num">{j.n}</p>
            <h4>{j.nome}</h4>
            <p class="j-resumo">{j.resumo}</p>
            <p class="j-sub"><strong>Como funciona:</strong> {j.como}</p>
            {j.recebe && <p class="j-sub"><strong>Você recebe:</strong> {j.recebe}</p>}
            <span class="badge-status">{j.status === "live" ? "Disponível hoje" : "Em construção"}</span>
          </div>
        ))}
      </div>

      <p class="eyebrow" style="margin-top:3rem;">As 6 dimensões do Diagnóstico</p>
      <dl class="dim-list">
        {dimensoes.map((d) => (
          <div class="dim-row">
            <dt>{d.nome}</dt>
            <dd>{d.desc}</dd>
          </div>
        ))}
      </dl>

      <p class="eyebrow" style="margin-top:3rem;">Níveis de maturidade digital</p>
      <div class="rubric">
        {maturidade.map((m) => (
          <div class={`rubric-lvl rubric-lvl-${m.n}`}>
            <b>{m.n} · {m.nome}</b>
            <span>{m.desc}</span>
          </div>
        ))}
      </div>

      <a class="btn btn-primary" style="margin-top:2.5rem;" href={DIAGNOSTICO_URL}>Faça o diagnóstico gratuito</a>
    </section>

    <section class="section band" id="pacce">
      <div class="pacce-grid">
        <div>
          <a href={PACCE_URL} target="_blank" rel="noopener" class="pacce-shot">
            <img src="/img/pacce-atendimento.png" alt="Tela de Gestão de Atendimentos do PACCE, com a seleção de tratamentos por departamento" />
          </a>
          <p class="pacce-shot-caption">Tela real do PACCE — base de demonstração.</p>
        </div>
        <div>
          <p class="eyebrow">Produto principal</p>
          <h2>PACCE — a plataforma de gestão que fica</h2>
          <p class="lede">
            Cadastro, atendimento e histórico organizados num só lugar. Multi-instituição, feito
            pra crescer junto com quem usa — não pra ser trocado em dois anos.
          </p>
          <p class="lede">
            Por dentro, o PACCE é simples: <strong>Overview</strong> pra ver o dia inteiro num
            relance, <strong>Atendimento</strong> pra abrir e acompanhar cada caso por
            departamento, <strong>Assistidos</strong> pra manter o cadastro e o histórico de cada
            um, e a área de <strong>Coordenação/Administração</strong> pra configurar tratamentos,
            turnos, instituição e equipe.
          </p>
          <ul class="pacce-feats">
            <li>Cadastro por QR Code ou recepção, sem depender de computador livre</li>
            <li>Histórico de atendimento com orientação e data de retorno</li>
            <li>Filas por setor com baixa — Passe, Cromoterapia, Desobsessão e mais</li>
            <li>Isolamento total de dados entre instituições diferentes</li>
          </ul>
          <a href="/pacce" class="btn btn-primary">Ver o PACCE de perto</a>
        </div>
      </div>
    </section>

    <section class="section" id="servicos">
      <p class="eyebrow">Serviços</p>
      <h2>O que sustenta o PACCE por fora</h2>
      <p class="lede">
        Presença, comunicação e crescimento — pra quem já resolveu a gestão interna e agora
        precisa aparecer, ou pra quem ainda está começando essa jornada.
      </p>
      <div class="servicos-grid">
        {servicos.map((s) => (
          <div class="servico-card">
            <h3>{s.nome}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="cta-final">
      <p class="cta-kicker">Vamos conversar</p>
      <h2 class="cta-big">Onde sua organização está hoje?</h2>
      <p class="lede">Faça o Diagnóstico LUMEN online agora — 10 minutos, sem compromisso, e você já sai com um retrato de onde sua organização está.</p>
      <a class="btn btn-primary" href={DIAGNOSTICO_URL}>Faça o diagnóstico gratuito</a>
    </section>

    <section class="section" id="contato">
      <div class="contato-grid">
        <div>
          <p class="eyebrow">Fale com a gente</p>
          <h2>Prefere conversar direto?</h2>
          <p class="lede">Sem venda insistente por telefone: a gente responde, você decide o próximo passo.</p>
          <div class="contact-alt">
            <a href="#">→ Falar agora pelo WhatsApp</a>
            <a href="mailto:contato@eloo.digital">→ contato@eloo.digital</a>
          </div>
        </div>
        <form class="mock-form" onsubmit="return false;">
          <div class="f-row">
            <div class="f-field">
              <label for="f-nome">Nome</label>
              <input id="f-nome" name="nome" type="text" placeholder="Seu nome" />
            </div>
            <div class="f-field">
              <label for="f-instituicao">Instituição</label>
              <input id="f-instituicao" name="instituicao" type="text" placeholder="Nome da organização" />
            </div>
          </div>
          <div class="f-row">
            <div class="f-field">
              <label for="f-email">E-mail</label>
              <input id="f-email" name="email" type="email" placeholder="voce@instituicao.org" />
            </div>
            <div class="f-field">
              <label for="f-whats">WhatsApp</label>
              <input id="f-whats" name="whatsapp" type="tel" placeholder="(11) 90000-0000" />
            </div>
          </div>
          <div class="f-field">
            <label for="f-interesse">O que você procura</label>
            <select id="f-interesse" name="interesse">
              <option>Diagnóstico gratuito</option>
              <option>PACCE</option>
              <option>Criação de Sites</option>
              <option>Marketing Digital</option>
              <option>Canais Digitais</option>
            </select>
          </div>
          <div class="f-field">
            <label for="f-msg">Mensagem (opcional)</label>
            <textarea id="f-msg" name="mensagem" rows="3" placeholder="Conte um pouco do que está acontecendo hoje"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Solicitar contato</button>
          <p class="form-note">Formulário ainda sem envio automático — próximo passo é conectar a um CRM real.</p>
        </form>
      </div>
    </section>

    <footer>
      <a href="#topo" class="wordmark" aria-label="eloo.digital, início">el<span class="oo">oo</span><span class="dot">.</span><span class="suffix">digital</span></a>
      <p>eloo.digital · PACCE, feito pela eloo.digital</p>
    </footer>
  </body>
</html>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 2rem;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-wordmark { text-decoration: none; color: var(--ink); font-size: 1.15rem; }
  .navlinks { display: flex; gap: 1.75rem; font-size: 0.88rem; font-weight: 600; }
  .navlinks a { text-decoration: none; color: var(--ink-soft); }
  .navlinks a:hover { color: var(--ink); }
  @media (max-width: 900px) { .navlinks { display: none; } }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.85rem 1.7rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .btn-nav { padding: 0.55rem 1.2rem; font-size: 0.85rem; background: var(--accent); color: var(--accent-ink); }
  .btn-nav:hover { background: color-mix(in srgb, var(--accent) 88%, black); }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover { background: color-mix(in srgb, var(--accent) 88%, black); }
  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .btn-ghost:hover { border-color: var(--ink-soft); }

  .hero {
    padding: 7rem 2rem 6rem;
    text-align: center;
  }
  .hero-inner { max-width: 760px; margin: 0 auto; }
  .badge {
    display: inline-block;
    max-width: 46ch;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 2rem;
    line-height: 1.4;
    background: var(--card);
  }
  h1 {
    font-family: var(--font-title);
    font-size: clamp(2.4rem, 5.6vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.08;
    margin: 0 0 1.3rem;
    text-wrap: balance;
    color: var(--ink);
  }
  h1 .accent { color: var(--accent); }
  .hero-sub {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0 auto 2.4rem;
    line-height: 1.6;
  }
  .hero-sub em { font-style: normal; font-weight: 600; color: var(--accent); }
  .hero-actions { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; }

  .section { max-width: 1080px; margin: 0 auto; padding: 6rem 2rem; }
  .band { max-width: none; background: var(--bg-alt); }
  .band > * { max-width: 1080px; margin-left: auto; margin-right: auto; }
  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }
  h2 {
    font-family: var(--font-title);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
    max-width: 32ch;
  }
  .lede {
    font-family: var(--font-body);
    font-size: 1.02rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 62ch;
    margin: 0 0 1.4rem;
  }

  /* Hub — o que fazemos */
  .hub-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 900px) { .hub-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .hub-grid { grid-template-columns: 1fr; } }
  .hub-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1.4rem 1.3rem; }
  .hub-card-core { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .hub-tag { font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; color: var(--accent); }
  .hub-card-core .hub-tag { color: color-mix(in srgb, var(--accent) 70%, white); }
  .hub-card h3 { font-family: var(--font-title); font-size: 1.05rem; margin: 0.5rem 0 0.4rem; font-weight: 600; }
  .hub-card p { font-family: var(--font-body); font-size: 0.85rem; margin: 0; color: var(--ink-soft); }
  .hub-card-core p { color: color-mix(in srgb, var(--bg) 85%, transparent); }

  /* Sobre */
  .sobre-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: start; }
  @media (max-width: 880px) { .sobre-grid { grid-template-columns: 1fr; } }
  .pills { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .pill { font-family: var(--font-title); font-size: 0.78rem; font-weight: 600; color: var(--support); background: var(--support-tint); border-radius: 999px; padding: 0.4rem 0.9rem; }
  .comp-list { display: flex; flex-direction: column; gap: 1rem; }
  .comp-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 1.2rem 1.3rem; }
  .comp-card h4 { font-family: var(--font-title); font-size: 0.95rem; margin: 0 0 0.4rem; font-weight: 600; }
  .comp-card p { font-family: var(--font-body); font-size: 0.85rem; margin: 0; color: var(--ink-soft); }

  /* PACCE showcase */
  .pacce-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  @media (max-width: 880px) { .pacce-grid { grid-template-columns: 1fr; } }
  .pacce-shot { display: block; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 20px 40px rgba(36,38,31,.16); }
  .pacce-shot img { width: 100%; height: auto; }
