# Caminho do JSON da conta de serviço do Google Cloud (montado via volume no docker-compose)
GOOGLE_CREDENTIALS_FILE=/app/credentials/credentials.json

# Chave usada para gerar os links de todos os clientes/módulos (auth.py).
# Compartilhada entre clientes (o token já inclui o slug do cliente na
# mensagem assinada) — trocar invalida TODOS os links de TODOS os clientes.
SECRET_KEY=troque-esta-chave-em-producao

# PIN de acesso interno da equipe (tela de login própria do app, em
# /assessment/_shared/responder/entrar — não é HTTP Basic Auth do nginx).
# Compartilhado entre clientes, uso da equipe só, nunca do cliente.
INTERNAL_PIN=

# Clientes e suas planilhas ficam em app/clientes.py (não é secret — a
# proteção real é o token por módulo, não o ID da planilha). Adicionar um
# cliente novo é só uma entrada nova nesse arquivo + deploy, sem tocar
# neste .env nem em nenhum secret do GitHub Actions.
