---
// Assessment de TI no padrão full-bleed editorial da v2 (mesmo topo,
// rodapé, fontes e tokens da home e do /pacce). Conteúdo técnico mantido.
// O formulário continua postando em /assessment/leads/enviar (CRM).
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (nome: string) => `${B}/img/${nome}`;

const frentes = [
  {
    letra: "A",
    nome: "Infraestrutura de TI",
    desc: "Redes, servidores, virtualização, endpoints, backup e disaster recovery.",
    perguntas: ["O backup já foi restaurado de verdade?", "Quem administra cada servidor e cada acesso?", "O que para se o principal equipamento cair?"],
    foto: "servico-solucoes.jpg",
    alt: "Tela com código e configurações de sistemas em um ambiente de trabalho",
  },
  {
    letra: "B",
    nome: "Sistemas e Aplicações",
    desc: "Portfólio de sistemas, bancos de dados, versionamento, integrações e segurança de aplicações.",
    perguntas: ["Quais sistemas sustentam a operação e quem responde por eles?", "Há sistema fora de suporte em uso crítico?", "As integrações estão documentadas?"],
    foto: "comp-tecnologia.jpg",
    alt: "Duas pessoas trabalhando lado a lado em notebooks",
  },
  {
    letra: "C",
    nome: "Governança e Processos de TI",
    desc: "Incidentes, mudanças, ativos, CMDB, fornecedores e documentação — COBIT 2019 e ITIL 4.",
    perguntas: ["Incidentes e mudanças seguem um processo ou dependem de quem está de plantão?", "O inventário de ativos tem dono?", "Os contratos com fornecedores têm nível de serviço medido?"],
    foto: "comp-consultoria.jpg",
    alt: "Reunião de análise entre duas pessoas com documentos sobre a mesa",
  },
];

const etapas = [
  { nome: "Kickoff", desc: "Interlocutores, acessos e agenda confirmados." },
  { nome: "Levantamento", desc: "Entrevistas e evidências, capítulo por capítulo." },
  { nome: "Avaliação de controles", desc: "De Adequado a Não aplicável, sempre com evidência." },
  { nome: "Avaliação de risco", desc: "De Crítico a Baixo, por probabilidade e impacto." },
  { nome: "Avaliação de maturidade", desc: "Escala de 0 a 5. Diagnóstico executivo, não certificação." },
];

const metodologias = [
  { nome: "COBIT 2019 Assessment Programme", base: "ISACA · base ISO/IEC 33001", desc: "Como pontuar capacidade de processo com rigor, não por percepção." },
  { nome: "SCAMPI", base: "SEI/CMMI Institute", desc: "Como coletar e validar evidência antes de atribuir maturidade." },
  { nome: "NIST SP 800-30 e ISO/IEC 27005", base: "NIST · ISO", desc: "O método de cálculo de risco em si." },
  { nome: "TOGAF ADM", base: "The Open Group", desc: "Diagnóstico e evolução de arquitetura, fases A a H." },
  { nome: "ITIL 4 Continual Improvement", base: "AXELOS", desc: "Estrutura do roadmap em quatro horizontes." },
];

const entregaveis = [
  { nome: "Relatório Executivo", desc: "O retrato para a diretoria, em linguagem de negócio." },
  { nome: "Relatório Técnico", desc: "O detalhe por domínio, para quem vai executar." },
  { nome: "Matriz de Riscos", desc: "Cada risco com probabilidade, impacto e dono." },
  { nome: "Matriz de Gaps", desc: "Situação atual, situação recomendada e a ação entre as duas." },
  { nome: "Inventário Consolidado", desc: "Ativos, sistemas e fornecedores num só lugar." },
  { nome: "Mapa de Maturidade", desc: "Gráfico radar por domínio, de 0 a 5." },
  { nome: "Plano de Ação e Roadmap", desc: "Quatro horizontes, dos quick-wins de 30 dias à estruturação de 12 meses." },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assessment de TI — eloo.digital</title>
    <meta name="description" content="Assessment de Governança, Infraestrutura e Sistemas de TI: diagnóstico técnico com rigor de working paper, baseado em COBIT 2019 e ITIL 4, para empresas que precisam saber onde estão antes de investir em evolução tecnológica." />
    <link rel="icon" type="image/svg+xml" href={`${B}/favicon.svg`} />
    <link rel="alternate icon" href={`${B}/favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="topo" id="topo">
      <a href="/" class="marca" aria-label="eloo.digital, página inicial">eloo<span>.digital</span></a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
      <div class="menu" id="menu">
        <a href="#o-que-e">O que é</a>
        <a href="#frentes">Frentes</a>
        <a href="#metodologia">Metodologia</a>
        <a href="#entregaveis">Entregáveis</a>
        <a href="#contato" class="menu-cta">Falar com um especialista</a>
      </div>
      <a href="#contato" class="cta-topo">Falar com um especialista</a>
    </nav>

    <main>

      <!-- HERO -->
      <section class="hero" id="inicio">
        <img class="hero-img" src={img("diagnostico-analise-noturna.jpg")} alt="Equipe de TI analisando o ambiente tecnológico à noite, com atenção aos detalhes" />
        <div class="scrim"></div>
        <div class="hero-inner wrap">
          <p class="selo">Assessment de TI · um serviço eloo.digital</p>
          <h1>Antes de investir em TI, <span class="destaque">saiba onde ela está.</span></h1>
          <p class="lede claro">Assessment de Governança, Infraestrutura e Sistemas de TI: diagnóstico técnico com rigor de auditoria, evidência em vez de achismo, sobre o que existe, como está e onde estão os riscos, antes de qualquer plano de evolução.</p>
          <div class="acoes">
            <a class="btn btn-primario" href="#contato">Falar com um especialista ↗</a>
            <a class="btn btn-ghost" href="#metodologia">Ver a metodologia ↓</a>
          </div>
          <ul class="hero-fatos" aria-label="Base do Assessment">
            <li><b>3 frentes</b> infraestrutura, sistemas e governança</li>
            <li><b>5 etapas</b> do kickoff à maturidade</li>
            <li><b>COBIT 2019 e ITIL 4</b> como padrão de controle</li>
          </ul>
        </div>
      </section>

      <!-- DECLARAÇÃO -->
      <section class="declaracao vermelho" id="o-que-e">
        <div class="wrap">
          <h2>Não é auditoria de conformidade. É um raio-x operacional.</h2>
          <p class="declaracao-texto">A maioria das empresas descobre um gap crítico de TI só quando ele já virou incidente. O Assessment encontra antes, com evidência documentada, não com uma lista genérica de boas práticas.</p>
          <ol class="dores">
            <li>Um backup que nunca foi testado.</li>
            <li>Uma senha administrativa que ninguém sabe quem mais conhece.</li>
            <li>Um sistema fora de suporte sustentando a operação inteira.</li>
          </ol>
        </div>
      </section>

      <!-- ANTES E DEPOIS -->
      <section class="bleed escuro" id="antes-depois">
        <img class="bleed-foto" src={img("pacce-seguranca.jpg")} alt="Notebook com tela de acesso protegido, sobre uma mesa" loading="lazy" />
        <div class="bleed-texto">
          <h2>Do que <span class="destaque">“existe”</span> ao que está comprovado.</h2>
          <div class="comparacao">
            <div>
              <h3>O que normalmente existe</h3>
              <ul class="lista lista-antes">
                <li>Inventário de TI incompleto ou desatualizado, sem dono claro por ativo</li>
                <li>Backup que “existe”, mas nunca teve teste de restauração comprovado</li>
                <li>Decisão de investimento em TI baseada em percepção, não em risco medido</li>
              </ul>
            </div>
            <div>
              <h3>Com o Assessment</h3>
              <ul class="lista lista-depois">
                <li>Cada controle classificado com evidência, nunca por declaração isolada</li>
                <li>Matriz de riscos e matriz de gaps, priorizadas por impacto real</li>
                <li>Roadmap de evolução em 4 horizontes, começando pelos quick-wins de 30 dias</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- FRENTES (faixas full-bleed alternadas) -->
      <div id="frentes">
        <div class="frentes-cabeca wrap">
          <h2>Três frentes do ambiente tecnológico.</h2>
          <p class="lede">O ciclo clássico de consultoria de governança de TI, diagnóstico, avaliação, priorização e roadmap, aplicado a cada uma delas.</p>
        </div>
        {frentes.map((f, i) => (
          <section class={`bleed ${i % 2 ? "bleed-reverso" : ""}`} id={`frente-${f.letra.toLowerCase()}`}>
            <img class="bleed-foto" src={img(f.foto)} alt={f.alt} loading="lazy" />
            <div class="bleed-texto">
              <span class="letra" aria-hidden="true">{f.letra}</span>
              <h3 class="frente-nome">{f.nome}</h3>
              <p class="lede">{f.desc}</p>
              <p class="perguntas-titulo">Perguntas que a frente responde</p>
              <ul class="lista">
                {f.perguntas.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </section>
        ))}
      </div>

      <!-- ETAPAS + METODOLOGIA -->
      <section class="metodologia escuro" id="metodologia">
        <div class="wrap">
          <div class="bloco-cabeca">
            <h2>Cinco etapas, <span class="destaque">sempre com evidência.</span></h2>
            <p class="lede claro">Cada frente passa pelas mesmas cinco etapas. Nenhuma nota é dada por declaração: o que não tem evidência não conta.</p>
          </div>
          <ol class="regua">
            {etapas.map((e, i) => (
              <li>
                <span class="regua-nivel">Etapa {i + 1}</span>
                <h3>{e.nome}</h3>
                <p>{e.desc}</p>
              </li>
            ))}
          </ol>

          <div class="lastro" id="lastro">
            <div class="lastro-texto">
              <h2>Como avaliamos, não só o que avaliamos.</h2>
              <p class="lede claro">COBIT e ITIL definem o padrão de controle esperado. O método de conduzir o assessment, como pontuar, validar evidência e calcular risco, vem de metodologias formais, públicas e adotadas por consultorias de TI de primeira linha.</p>
              <p class="nota claro">Nenhuma delas é propriedade de uma consultoria: são normas e modelos públicos (ISACA, SEI/CMMI Institute, NIST, ISO, The Open Group, AXELOS). Isso dá rigor auditável ao diagnóstico sem depender de licença de terceiros.</p>
            </div>
            <dl class="metodos">
              {metodologias.map((m) => (
                <div>
                  <dt>{m.nome}<small>{m.base}</small></dt>
                  <dd>{m.desc}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>

      <!-- ENTREGÁVEIS -->
      <section class="entregaveis" id="entregaveis">
        <div class="wrap entregaveis-grid">
          <div>
            <h2>O que fica com você <span class="destaque-ink">ao final.</span></h2>
            <p class="lede">Sete documentos de trabalho, escritos para dois públicos: a diretoria que decide e o time que executa.</p>
          </div>
          <ol class="entregaveis-lista">
            {entregaveis.map((e) => (
              <li><b>{e.nome}</b><span>{e.desc}</span></li>
            ))}
          </ol>
        </div>
      </section>

      <!-- CONTATO full-bleed -->
      <section class="contato" id="contato">
        <img class="contato-img" src={img("comp-consultoria.jpg")} alt="" loading="lazy" />
        <div class="scrim scrim-total"></div>
        <div class="wrap contato-grid">
          <div class="contato-texto">
            <p class="tempo">Comece pela conversa</p>
            <h2>Descubra onde a sua operação de TI <span class="destaque">está hoje.</span></h2>
            <p class="lede claro">Escopo e esforço dimensionados pelo porte da sua empresa antes de qualquer compromisso.</p>
          </div>
          <form class="form-contato" method="POST" action="https://eloo.digital/assessment/leads/enviar">
            <div class="hp" aria-hidden="true">
              <label for="site">Deixe em branco</label>
              <input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="interesse" value="Assessment de TI" />
            <input type="hidden" name="origem" value="Página Assessment" />
            <div class="form-row">
              <label class="campo" for="f-nome">Nome<input id="f-nome" type="text" name="nome" autocomplete="name" required /></label>
              <label class="campo" for="f-empresa">Empresa<input id="f-empresa" type="text" name="empresa" autocomplete="organization" required /></label>
            </div>
            <div class="form-row">
              <label class="campo" for="f-email">E-mail<input id="f-email" type="email" name="email" autocomplete="email" required /></label>
              <label class="campo" for="f-telefone">Telefone <small>(opcional)</small><input id="f-telefone" type="tel" name="telefone" autocomplete="tel" /></label>
            </div>
            <label class="campo" for="f-mensagem">Cenário <small>(opcional)</small><textarea id="f-mensagem" name="mensagem" rows="3" placeholder="Porte da empresa e o que mais preocupa hoje"></textarea></label>
            <button type="submit" class="btn btn-primario">Falar com um especialista ↗</button>
          </form>
        </div>
      </section>

    </main>

    <footer class="rodape">
      <div class="wrap rodape-grid">
        <div>
          <a href="/" class="marca">eloo<span>.digital</span></a>
          <p>Tecnologia para transformar operações.</p>
        </div>
        <div>
          <b>Empresa</b>
          <a href="/#sobre">Sobre</a><a href="/#metodologia">Metodologia</a><a href="/diagnostico">Contato</a>
        </div>
        <div>
          <b>O que fazemos</b>
          <a href="/#automacao">Automação</a><a href="/#ia">Inteligência artificial</a><a href="/#capacidades">Desenvolvimento e integrações</a><a href="/#capacidades">Transformação digital</a><a href="/assessment" aria-current="page">Assessment de TI</a>
        </div>
        <div>
          <b>Produtos</b>
          <a href="/pacce">PACCE</a>
        </div>
      </div>
      <div class="wrap rodape-base">
        <span>© eloo.digital</span>
        <span>Assessment de TI, um serviço da eloo.digital.</span>
        <a href="#topo">Voltar ao topo ↑</a>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("menu-btn");
      const menu = document.getElementById("menu");
      btn.addEventListener("click", () => {
        const aberto = menu.classList.toggle("aberto");
        btn.classList.toggle("aberto", aberto);
        btn.setAttribute("aria-expanded", String(aberto));
      });
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
        menu.classList.remove("aberto"); btn.classList.remove("aberto"); btn.setAttribute("aria-expanded", "false");
      }));
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #f4f2ed;
    --bg-alt: #e6e4dd;
    --card: #fbfaf7;
    --ink: #1f1f1d;
    --ink-soft: #55554f;
    --line: #d8d6ce;
    --accent: #e0201a;
    --accent-deep: #b8160f;
    --accent-ink: #fff3f2;
    --escuro: #1f1f1d;
    --destaque-escuro: #ff8a84;
    --font-title: 'Bricolage Grotesque', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --ease: cubic-bezier(.16, 1, .3, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--font-title); letter-spacing: -0.015em; text-wrap: balance; margin: 0; }
  p { margin: 0 0 1rem; text-wrap: pretty; }
  ul, ol { margin: 0; }
  section[id], #frentes { scroll-margin-top: 4.5rem; }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.4rem; }
  .destaque { color: var(--destaque-escuro); }
  .destaque-ink { color: var(--accent); }
  .lede { font-size: 1.08rem; color: var(--ink-soft); max-width: 60ch; }
  .lede.claro, .claro { color: rgba(255, 255, 255, .86); }
  .escuro { background: var(--escuro); color: #fff; }
  .escuro h2, .escuro h3 { color: #fff; }
  .vermelho { background: var(--accent); color: var(--accent-ink); }

  /* Botões */
  .btn { display: inline-flex; align-items: center; gap: .4rem; border-radius: 999px; padding: .9rem 1.55rem; font-family: var(--font-title); font-weight: 700; font-size: .96rem; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: background .2s ease, transform .3s var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .btn-primario { background: var(--accent); color: var(--accent-ink); }
  .btn-primario:hover { background: var(--accent-deep); }
  .btn-ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, .6); }
  .btn-ghost:hover { border-color: #fff; }
  .acoes { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.8rem; }

  /* Topo (igual à home) */
  .topo { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1.4rem; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .marca { font-family: var(--font-title); font-weight: 800; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .marca span { font-weight: 500; color: var(--ink-soft); }
  .menu { display: flex; gap: 1.5rem; font-size: .9rem; font-weight: 600; }
  .menu a { text-decoration: none; color: var(--ink-soft); }
  .menu a:hover { color: var(--accent); }
  .menu-cta { display: none; }
  .cta-topo { background: var(--accent); color: var(--accent-ink); border-radius: 999px; padding: .55rem 1.1rem; font-size: .85rem; font-weight: 700; text-decoration: none; }
  .menu-btn { display: none; background: none; border: none; width: 2.2rem; height: 2.2rem; flex-direction: column; justify-content: center; align-items: flex-end; gap: 5px; padding: 0; cursor: pointer; }
  .menu-btn span { display: block; width: 100%; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .25s ease, opacity .25s ease; }
  .menu-btn.aberto span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn.aberto span:nth-child(2) { opacity: 0; }
  .menu-btn.aberto span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .cta-topo { display: none; }
    .menu { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 1.1rem; background: var(--card); border-bottom: 1px solid var(--line); padding: 1.5rem 1.4rem 2rem; box-shadow: 0 16px 32px rgba(0, 0, 0, .12); }
    .menu.aberto { display: flex; }
    .menu-cta { display: block; color: var(--accent); }
  }

  /* Hero */
  .hero { position: relative; min-height: min(92vh, 800px); color: #fff; overflow: hidden; display: flex; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20, 20, 18, .95) 0%, rgba(20, 20, 18, .72) 42%, rgba(20, 20, 18, .35) 75%, rgba(20, 20, 18, .2) 100%); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-top: 7rem; padding-bottom: 3.5rem; width: 100%; }
  .selo { align-self: flex-start; border: 1px solid rgba(255, 255, 255, .3); border-radius: 999px; padding: .4rem 1rem; font-family: var(--font-title); font-weight: 600; font-size: .85rem; color: rgba(255, 255, 255, .88); margin: 0 0 1.4rem; }
  .hero h1 { font-size: clamp(2.3rem, 5.6vw, 4.4rem); line-height: 1.04; max-width: 16ch; color: #fff; margin-bottom: 1.3rem; }
  .hero .lede { font-size: 1.12rem; max-width: 58ch; }
  .hero-fatos { list-style: none; padding: 1.4rem 0 0; margin: 2.6rem 0 0; border-top: 1px solid rgba(255, 255, 255, .22); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; font-size: .92rem; color: rgba(255, 255, 255, .8); max-width: 900px; }
  .hero-fatos b { display: block; font-family: var(--font-title); font-size: 1.05rem; color: #fff; }
  @media (max-width: 720px) {
    .hero-fatos { grid-template-columns: 1fr; gap: .9rem; }
    .hero .scrim { background: linear-gradient(0deg, rgba(20, 20, 18, .96) 0%, rgba(20, 20, 18, .82) 60%, rgba(20, 20, 18, .5) 100%); }
  }

  /* Declaração */
  .declaracao { padding: clamp(4.5rem, 9vw, 7.5rem) 0; }
  .declaracao h2 { font-size: clamp(2rem, 4.6vw, 3.5rem); line-height: 1.08; max-width: 18ch; color: var(--accent-ink); margin-bottom: 1.4rem; }
  .declaracao-texto { font-size: 1.12rem; max-width: 58ch; color: color-mix(in srgb, var(--accent-ink) 92%, transparent); }
  .dores { list-style: none; padding: 0; margin: 2.6rem 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 243, 242, .35); }
  .dores li { font-family: var(--font-title); font-size: clamp(1.1rem, 1.9vw, 1.4rem); font-weight: 600; line-height: 1.25; padding: 1.4rem 1.6rem 0 0; }
  .dores li + li { padding-left: 1.6rem; border-left: 1px solid rgba(255, 243, 242, .35); }
  @media (max-width: 760px) {
    .dores { grid-template-columns: 1fr; }
    .dores li, .dores li + li { padding: 1.1rem 0; border-left: none; border-bottom: 1px solid rgba(255, 243, 242, .35); }
  }

  /* Faixas full-bleed */
