---
import '../styles/global.css';
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/700.css';
import '@fontsource/bricolage-grotesque/800.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';

// Modelo LUMEN (2 eixos ponderados: Maturidade Digital + Controle de
// Processos), preparado por Alessandro a partir da prática real de 7 anos de
// campo. Cada pergunta tem uma "trilha" — PACCE (operação interna: cadastro,
// atendimento, escalas, indicadores, prestação de contas) ou Serviços
// (presença digital, marketing/captação, tecnologia/segurança, soluções sob
// medida) — escolhida na etapa 0. As perguntas puramente operacionais do
// modelo original cobriam bem a trilha PACCE; a trilha Serviços ganhou 5
// perguntas novas (marcadas "// nova") porque o modelo original só tocava de
// leve em marketing/captação (só site + redes sociais + canal de contato).
const PERGUNTAS = [
  {
    id: "Q01", dimensao: "atendimento-dados", trilha: "pacce",
    texto: "Como é realizado o cadastro de um assistido novo?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Somente presencial e em papel",
      "Em papel e depois digitado manualmente",
      "Digital, mas em planilha ou ferramenta não integrada",
      "Em sistema, com campos e rotina padronizados",
      "Pré-cadastro digital + validações + integração com o atendimento",
    ],
  },
  {
    id: "Q02", dimensao: "atendimento-dados", trilha: "pacce",
    texto: "Como é feita a atualização dos dados cadastrais dos assistidos?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não existe rotina definida",
      "Cada trabalhador atualiza de um jeito",
      "Atualizamos em planilha ou registros separados",
      "Há responsável e periodicidade definidos no sistema",
      "O cadastro tem histórico, validações e revisão periódica controlada",
    ],
  },
  {
    id: "Q03", dimensao: "atendimento-dados", trilha: "pacce",
    texto: "Como são registrados os atendimentos e a evolução de cada caso?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Em papel, caderneta ou ficha física",
      "Cada trabalhador registra de maneira própria",
      "Em planilha compartilhada ou arquivos separados",
      "No mesmo sistema do cadastro, com padrão de registro",
      "Registro estruturado, histórico por assistido, permissões e rastreabilidade",
    ],
  },
  {
    id: "Q04", dimensao: "processos-rotinas", trilha: "pacce",
    texto: "Quanto os processos de atendimento estão padronizados e documentados?",
    pesoDig: 0.5, pesoProc: 1,
    opcoes: [
      "Não há processo definido",
      "O processo é conhecido informalmente pelos trabalhadores",
      "Existem algumas orientações, mas variam entre equipes",
      "Processo documentado, com responsáveis e treinamento",
      "Processo documentado, medido e revisado periodicamente",
    ],
  },
  {
    id: "Q05", dimensao: "indicadores-melhoria", trilha: "pacce",
    texto: "Com que facilidade a instituição acompanha indicadores de atendimento?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não temos os números",
      "Apenas estimamos ou avaliamos informalmente",
      "É possível levantar, mas exige contagem manual",
      "Os indicadores são atualizados em relatórios ou painel",
      "Indicadores são atualizados automaticamente e mostram tendências",
    ],
  },
  {
    id: "Q06", dimensao: "indicadores-melhoria", trilha: "pacce",
    texto: "Como a instituição identifica faltas, interrupções e possível abandono do acompanhamento?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não acompanhamos",
      "Descobrimos apenas quando alguém percebe",
      "Conseguimos identificar manualmente",
      "Há rotina de acompanhamento e contato de retorno",
      "Há alertas, histórico e segmentação para acompanhamento estruturado",
    ],
  },
  {
    // Reclassificada do "Comunicação e Relacionamento" original: lembrete de
    // retorno/sessão é automação de um processo de atendimento (encaixe
    // natural com PACCE), não uma ação de marketing/captação.
    id: "Q07", dimensao: "processos-rotinas", trilha: "pacce",
    texto: "Como são enviados lembretes de retorno, próxima sessão ou outros compromissos?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Não enviamos lembretes",
      "Apenas quando alguém se lembra",
      "Existe rotina, mas o envio é manual",
      "Há lembretes automáticos ou semiautomáticos",
      "Lembretes personalizados e integrados ao fluxo de atendimento",
    ],
  },
  {
    id: "Q08", dimensao: "processos-rotinas", trilha: "pacce",
    texto: "Como as escalas de atendimento são montadas e acompanhadas?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Principalmente por mensagens, sem controle estruturado",
      "Planilha, quadro físico ou controle manual",
      "Sistema/planilha estruturada, mas sem alertas",
      "Sistema com lembretes e confirmação de participação",
      "Sistema com alertas, conflitos, confirmações e histórico de escala",
    ],
  },
  {
    id: "Q09", dimensao: "processos-rotinas", trilha: "pacce",
    texto: "O que acontece quando um trabalhador escalado não pode comparecer?",
    pesoDig: 0.5, pesoProc: 1,
    opcoes: [
      "Não existe plano de substituição",
      "Depende de uma pessoa encontrar alguém",
      "Existe substituição manual, mas sem rotina documentada",
      "Há regra de substituição e responsáveis definidos",
      "Há plano de contingência, alertas e acompanhamento de cobertura",
    ],
  },
  {
    id: "Q10", dimensao: "tecnologia-seguranca", trilha: "servicos",
    texto: "Como são armazenados e localizados documentos, formulários e registros administrativos?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Principalmente em papel ou arquivos dispersos",
      "Em pastas locais, computadores ou pendrives",
      "Em nuvem, mas sem padrão consistente de organização",
      "Em repositório estruturado, com pastas e regras definidas",
      "Com pesquisa, controle de versões, permissões e política de retenção",
    ],
  },
  {
    id: "Q11", dimensao: "tecnologia-seguranca", trilha: "servicos",
    texto: "Como é controlado quem pode acessar os dados dos assistidos e os documentos internos?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Praticamente qualquer pessoa autorizada a usar o dispositivo consegue acessar",
      "Há contas ou acessos compartilhados",
      "Alguns dados têm restrição, mas sem padrão completo",
      "Existem perfis de acesso por função",
      "Perfis são revisados periodicamente e há rastreabilidade de acessos",
    ],
  },
  {
    id: "Q12", dimensao: "tecnologia-seguranca", trilha: "servicos",
    texto: "Se o sistema ou computador principal ficar indisponível amanhã, o que acontece com os dados?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Podemos perder dados ou não sabemos informar",
      "Temos algum backup, mas nunca testamos",
      "Fazemos backups regulares, porém com controle limitado",
      "Backup e recuperação já foram testados",
      "Há cópias redundantes, monitoramento e plano de continuidade",
    ],
  },
  {
    id: "Q13", dimensao: "tecnologia-seguranca", trilha: "servicos",
    texto: "Como a instituição utiliza sistemas ou ferramentas digitais para a gestão?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não utiliza ferramenta de gestão",
      "Utiliza ferramentas isoladas e independentes",
      "Possui sistema para parte dos processos",
      "Possui sistema central para os principais processos",
      "Sistemas e formulários estão integrados, evitando retrabalho e duplicidade",
    ],
  },
  {
    id: "Q14", dimensao: "tecnologia-seguranca", trilha: "servicos",
    texto: "Como a instituição acompanha atualizações, mudanças e melhorias nas ferramentas digitais que utiliza?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Não sabemos se as ferramentas estão atualizadas",
      "Fazemos atualizações somente quando surgem problemas",
      "Atualizamos eventualmente e de forma manual",
      "As principais ferramentas permanecem atualizadas",
      "Há responsável, calendário de revisão e avaliação de melhorias/integrações",
    ],
  },
  {
    id: "Q15", dimensao: "gestao-prestacao-contas", trilha: "pacce",
    texto: "Como é feita a prestação de contas para a diretoria/assembleia?",
    pesoDig: 0.5, pesoProc: 1,
    opcoes: [
      "Não há processo definido",
      "Manual, em papel ou controles dispersos",
      "Feita por planilha e exige bastante retrabalho",
      "Sistema gera relatórios padronizados com pouca intervenção",
      "Processo fechado, rastreável e acompanhado por indicadores",
    ],
  },
  {
    id: "Q16", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Qual é o nível de atualização e utilidade do site da instituição?",
    pesoDig: 1, pesoProc: 0,
    opcoes: [
      "Não temos site",
      "Temos, mas está desatualizado",
      "Atualizamos eventualmente",
      "Site ativo, atualizado e com informações essenciais",
      "Site ativo com serviços, formulários/canais úteis e acompanhamento de acesso",
    ],
  },
  {
    id: "Q17", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Como as redes sociais são administradas?",
    pesoDig: 1, pesoProc: 0,
    opcoes: [
      "Não há presença ativa",
      "Publicamos esporadicamente, sem rotina",
      "Há alguém responsável, mas sem calendário consistente",
      "Existe calendário editorial e acompanhamento básico de métricas",
      "Há planejamento, métricas e integração com os objetivos de comunicação da casa",
    ],
  },
  {
    id: "Q18", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Como a instituição recebe dúvidas, solicitações e feedback dos assistidos?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Somente presencialmente, sem registro estruturado",
      "Por canais informais, sem padrão de resposta",
      "Existem canais definidos, mas o controle ainda é manual",
      "Há canal estruturado, responsáveis e registro das solicitações",
      "Há triagem, acompanhamento de prazo e indicadores de satisfação/retorno",
    ],
  },
  {
    id: "Q19", dimensao: "indicadores-melhoria", trilha: "pacce",
    texto: "Com que frequência os dados e resultados são usados para decidir melhorias nos processos?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não usamos dados para decidir melhorias",
      "As decisões dependem principalmente de percepção e experiência",
      "Consultamos dados de forma ocasional",
      "Há reuniões/rotinas periódicas para analisar indicadores e definir ações",
      "Existe ciclo contínuo de medir, agir, revisar resultados e ajustar processos",
    ],
  },
  // Perguntas novas — trilha Serviços. O modelo original de 19 perguntas
  // avaliava sobretudo operação interna (o que virou a trilha PACCE); pra
  // avaliar Serviços com o mesmo rigor, faltava cobrir captação, ROI de
  // marketing, integração entre canais e maturidade pra soluções sob medida.
  {
    id: "NQ01", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Como a instituição atrai novos contatos, doadores ou voluntários hoje?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Não há nenhuma ação de captação — depende só de quem já conhece",
      "Ações pontuais e isoladas, sem planejamento",
      "Existe alguma campanha ocasional, mas sem funil definido",
      "Há um funil de captação estruturado (conteúdo → contato → conversão)",
      "Funil estruturado, automatizado e otimizado com base em dados de conversão",
    ],
  },
  {
    id: "NQ02", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Como é medido o retorno das ações de comunicação e marketing?",
    pesoDig: 1, pesoProc: 1,
    opcoes: [
      "Não medimos nada",
      "Só olhamos curtidas/seguidores, sem ligar a resultado real",
      "Acompanhamos alguns números manualmente, sem consolidar",
      "Há indicadores definidos (alcance, conversão, custo por contato)",
      "Painel de indicadores consolidado, revisado periodicamente e usado pra decisão",
    ],
  },
  {
    id: "NQ03", dimensao: "comunicacao-relacionamento", trilha: "servicos",
    texto: "Como o conteúdo publicado é gerenciado entre site, redes sociais e outros canais?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Cada canal é atualizado de forma separada e sem padrão",
      "Uma pessoa tenta manter tudo atualizado manualmente",
      "Existe algum planejamento, mas a publicação ainda é manual em cada canal",
      "Há um calendário único e publicação coordenada entre canais",
      "Publicação integrada/automatizada a partir de um só lugar, com consistência de marca",
    ],
  },
  {
    id: "NQ04", dimensao: "solucoes-digitais", trilha: "servicos",
    texto: "Existe alguma tarefa ou processo que hoje depende de planilha, papel ou retrabalho manual porque nenhuma ferramenta pronta resolve?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Não sabemos identificar isso",
      "Sim, várias, mas nunca avaliamos o impacto",
      "Identificamos os principais gargalos, mas sem plano de solução",
      "Já mapeamos e priorizamos o que precisaria de uma solução sob medida",
      "Já temos (ou estamos implementando) uma solução sob medida pra esse gargalo",
    ],
  },
  {
    id: "NQ05", dimensao: "solucoes-digitais", trilha: "servicos",
    texto: "Quando surge uma necessidade nova de sistema ou processo digital, como a instituição resolve isso hoje?",
    pesoDig: 1, pesoProc: 0.5,
    opcoes: [
      "Não resolve — convive com a limitação",
      "Tenta um jeito manual ou paliativo",
      "Pesquisa ferramentas prontas no mercado, sem avaliar se encaixam de verdade",
      "Avalia entre ferramenta pronta e solução sob medida, conforme o caso",
      "Tem um parceiro de tecnologia que avalia e constrói sob medida quando necessário",
    ],
  },
];

const DIMENSOES = {
  "atendimento-dados": { nome: "Atendimento e Dados", ofertas: ["PACCE"] },
  "processos-rotinas": { nome: "Processos e Rotinas", ofertas: ["PACCE"] },
  "indicadores-melhoria": { nome: "Indicadores e Melhoria", ofertas: ["PACCE"] },
  "comunicacao-relacionamento": {
    nome: "Comunicação e Relacionamento",
    ofertas: ["Sites Institucionais Inteligentes (com CMS)", "Marketing Digital e Captação Estratégica", "Sincronização de Canais Digitais"],
  },
  "tecnologia-seguranca": { nome: "Tecnologia, Segurança e Continuidade", ofertas: ["Assessment de TI"] },
  "gestao-prestacao-contas": { nome: "Gestão e Prestação de Contas", ofertas: ["PACCE"] },
  "solucoes-digitais": { nome: "Soluções sob Medida", ofertas: ["Soluções Digitais"] },
};

---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diagnóstico LUMEN — eloo.digital</title>
    <meta
      name="description"
      content="Descubra em poucos minutos o nível de maturidade digital da sua instituição — cadastro, processos, indicadores, comunicação, tecnologia e prestação de contas — e receba um retrato imediato, na tela, com os próximos passos recomendados."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
  </head>
  <body>
    <nav>
      <a href="/#topo" class="wordmark nav-wordmark" aria-label="eloo.digital, início">el<span class="oo">oo</span><span class="dot">.</span><span class="suffix">digital</span></a>
      <div class="navlinks">
        <a href="/">← eloo.digital</a>
      </div>
    </nav>

    <header class="hero reveal" id="topo">
      <div class="hero-inner">
        <span class="badge">Diagnóstico gratuito</span>
        <h1>Onde a sua organização está <span class="accent">hoje</span>?</h1>
        <p class="hero-sub">
          Perguntas rápidas, clique único cada uma, ajustadas pro que você busca — gestão interna
          (PACCE) ou presença digital e marketing (Serviços). No fim, você vê o resultado na hora,
          sem esperar e-mail nenhum.
        </p>
      </div>
    </header>

    <main id="app" class="section">
      <!-- Etapa 0 — interesse declarado -->
      <section id="step-interesse" class="diag-step">
        <p class="eyebrow">Antes de começar</p>
        <h2>O que você está buscando?</h2>
        <p class="lede">Isso não muda as perguntas — só ajuda a gente a te dar uma recomendação mais certeira no final.</p>
        <div class="interesse-grid">
          <button type="button" class="interesse-card" data-interesse="PACCE">
            <span class="interesse-tag">Produto</span>
            <h3>PACCE</h3>
            <p>Gestão de cadastro, atendimento, escalas e histórico.</p>
          </button>
          <button type="button" class="interesse-card" data-interesse="Serviços">
            <span class="interesse-tag">Serviços</span>
            <h3>Serviços</h3>
            <p>Site, marketing digital, canais, assessment de TI, soluções sob medida.</p>
          </button>
          <button type="button" class="interesse-card" data-interesse="PACCE + Serviços">
            <span class="interesse-tag">Ambos</span>
            <h3>PACCE + Serviços</h3>
            <p>Ainda não sei — quero um retrato completo antes de decidir.</p>
          </button>
        </div>
      </section>

      <!-- Etapa 1 — perguntas, uma de cada vez -->
      <section id="step-perguntas" class="diag-step" hidden>
        <div class="diag-progress">
          <div class="diag-progress-bar"><div id="diag-progress-fill"></div></div>
          <span id="diag-progress-label">Pergunta 1 de 19</span>
        </div>
        <p class="eyebrow" id="diag-dimensao-atual"></p>
        <h2 id="diag-pergunta-atual"></h2>
        <div class="diag-opcoes" id="diag-opcoes"></div>
        <div class="diag-nav">
          <button type="button" class="btn btn-ghost" id="diag-voltar">← Voltar</button>
        </div>
      </section>

      <!-- Etapa 2 — resultado -->
      <section id="step-resultado" class="diag-step" hidden>
        <p class="eyebrow">Resultado</p>
        <h2>O retrato da sua organização agora</h2>

        <div class="resultado-eixos">
          <div class="eixo-card eixo-geral">
            <span class="eixo-label">Índice geral</span>
            <span class="eixo-score" id="score-geral"></span>
            <span class="eixo-nivel" id="nivel-geral"></span>
          </div>
          <div class="eixo-card">
            <span class="eixo-label">Maturidade Digital</span>
            <span class="eixo-score" id="score-digital"></span>
            <span class="eixo-nivel" id="nivel-digital"></span>
          </div>
          <div class="eixo-card">
            <span class="eixo-label">Controle de Processos</span>
            <span class="eixo-score" id="score-processos"></span>
            <span class="eixo-nivel" id="nivel-processos"></span>
          </div>
        </div>

        <p class="eyebrow" style="margin-top:3rem;">Por dimensão</p>
        <div class="dim-resultado-list" id="dim-resultado-list"></div>

        <p class="eyebrow" style="margin-top:3rem;">Recomendado para você</p>
        <p class="lede" id="recomendacao-texto"></p>
        <div class="recomendacao-chips" id="recomendacao-chips"></div>

        <div class="diag-contato">
          <p class="eyebrow" style="margin-top:0;">Quer essa devolutiva com a gente?</p>
          <h3>Deixe pelo menos um contato e falamos com você</h3>
          <p class="lede">Nada aqui é obrigatório, mas precisamos de e-mail ou WhatsApp pra te responder.</p>
          <form id="diag-contato-form" class="mock-form">
            <div class="f-row">
              <div class="f-field">
                <label for="d-nome">Nome</label>
                <input id="d-nome" name="nome" type="text" placeholder="Seu nome (opcional)" />
              </div>
              <div class="f-field">
                <label for="d-email">E-mail</label>
                <input id="d-email" name="email" type="email" placeholder="voce@instituicao.org" />
              </div>
            </div>
            <div class="f-field">
              <label for="d-whats">WhatsApp</label>
              <input id="d-whats" name="whatsapp" type="tel" placeholder="(11) 90000-0000" />
            </div>
            <input type="text" name="site" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit" class="btn btn-primary" id="diag-contato-submit">Quero falar com a eloo.digital</button>
          </form>
          <p class="form-note" id="diag-contato-status" role="status"></p>
        </div>
      </section>
    </main>

    <footer>
      <a href="/#topo" class="wordmark" aria-label="eloo.digital, início">el<span class="oo">oo</span><span class="dot">.</span><span class="suffix">digital</span></a>
      <p>eloo.digital · Metodologia LUMEN</p>
    </footer>

    <script define:vars={{ PERGUNTAS, DIMENSOES }}>
      function nivelDe(score) {
        if (score < 1) return "Inicial";
        if (score < 2) return "Básico";
        if (score < 3) return "Em desenvolvimento";
        if (score < 3.5) return "Consolidado";
        return "Avançado / Integrado";
      }
      function prioridadeDe(score) {
        if (score < 2) return "Alta";
        if (score < 3) return "Média";
        return "Baixa";
      }

      const state = {
        interesse: null,
        perguntasAtivas: [],
        indice: -1,
        respostas: [],
      };

      // "PACCE" -> só perguntas da trilha pacce. "Serviços" -> só servicos.
      // "PACCE + Serviços" -> as duas trilhas, sem repetir pergunta nenhuma
      // (nenhuma pergunta pertence às duas trilhas ao mesmo tempo).
      function perguntasDaTrilha(interesse) {
        if (interesse === "PACCE") return PERGUNTAS.filter((p) => p.trilha === "pacce");
        if (interesse === "Serviços") return PERGUNTAS.filter((p) => p.trilha === "servicos");
        return PERGUNTAS;
      }

      const stepInteresse = document.getElementById("step-interesse");
      const stepPerguntas = document.getElementById("step-perguntas");
      const stepResultado = document.getElementById("step-resultado");

      // Etapa 0
      document.querySelectorAll(".interesse-card").forEach((card) => {
        card.addEventListener("click", () => {
          state.interesse = card.dataset.interesse;
          state.perguntasAtivas = perguntasDaTrilha(state.interesse);
          state.respostas = new Array(state.perguntasAtivas.length).fill(null);
          document.querySelectorAll(".interesse-card").forEach((c) => c.classList.remove("is-selected"));
          card.classList.add("is-selected");
          stepInteresse.hidden = true;
          stepPerguntas.hidden = false;
          state.indice = 0;
          renderPergunta();
          stepPerguntas.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      // Etapa 1 — uma pergunta por vez
      const elProgressFill = document.getElementById("diag-progress-fill");
      const elProgressLabel = document.getElementById("diag-progress-label");
      const elDimensaoAtual = document.getElementById("diag-dimensao-atual");
      const elPerguntaAtual = document.getElementById("diag-pergunta-atual");
      const elOpcoes = document.getElementById("diag-opcoes");
      const elVoltar = document.getElementById("diag-voltar");

      function renderPergunta() {
        const p = state.perguntasAtivas[state.indice];
        const total = state.perguntasAtivas.length;
        elProgressFill.style.width = `${((state.indice) / total) * 100}%`;
        elProgressLabel.textContent = `Pergunta ${state.indice + 1} de ${total}`;
        elDimensaoAtual.textContent = DIMENSOES[p.dimensao].nome;
        elPerguntaAtual.textContent = p.texto;
        elVoltar.textContent = state.indice === 0 ? "← Trocar o que estou buscando" : "← Voltar";

        elOpcoes.innerHTML = "";
        p.opcoes.forEach((texto, i) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "diag-opcao";
          if (state.respostas[state.indice] === i) btn.classList.add("is-selected");
          btn.innerHTML = `<span class="diag-opcao-n">${i}</span><span>${texto}</span>`;
          btn.addEventListener("click", () => {
            state.respostas[state.indice] = i;
            avancar();
          });
          elOpcoes.appendChild(btn);
        });
      }

      function avancar() {
        if (state.indice < state.perguntasAtivas.length - 1) {
          state.indice += 1;
          renderPergunta();
        } else {
          elProgressFill.style.width = "100%";
          calcularEExibirResultado();
          stepPerguntas.hidden = true;
          stepResultado.hidden = false;
          stepResultado.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      elVoltar.addEventListener("click", () => {
        if (state.indice > 0) {
          state.indice -= 1;
          renderPergunta();
          return;
        }
        // Na primeira pergunta, "Voltar" leva de volta pra escolha PACCE/
        // Serviços/Ambos, caso a pessoa tenha clicado na caixinha errada.
        stepPerguntas.hidden = true;
        stepInteresse.hidden = false;
        document.querySelectorAll(".interesse-card").forEach((c) => c.classList.remove("is-selected"));
        stepInteresse.scrollIntoView({ behavior: "smooth", block: "start" });
      });

      // Etapa 2 — cálculo e exibição
      let resultadoCalculado = null;

      function calcularEExibirResultado() {
        let somaDig = 0, pesoDig = 0, somaProc = 0, pesoProc = 0;
        const porDimensao = {};

        state.perguntasAtivas.forEach((p, i) => {
          const score = state.respostas[i];
          somaDig += score * p.pesoDig;
          pesoDig += p.pesoDig;
          somaProc += score * p.pesoProc;
          pesoProc += p.pesoProc;

          if (!porDimensao[p.dimensao]) porDimensao[p.dimensao] = { soma: 0, peso: 0 };
          const pesoCombinado = p.pesoDig + p.pesoProc;
          porDimensao[p.dimensao].soma += score * pesoCombinado;
          porDimensao[p.dimensao].peso += pesoCombinado;
        });

        const maturidadeDigital = pesoDig ? somaDig / pesoDig : 0;
        const controleProcessos = pesoProc ? somaProc / pesoProc : 0;
        const indiceGeral = (maturidadeDigital + controleProcessos) / 2;

        // Só dimensões com pelo menos 1 pergunta respondida nesta trilha —
        // sem isso, uma dimensão nunca perguntada apareceria com score 0
        // (falsa prioridade "Alta").
        const dimensoesResultado = Object.keys(porDimensao).map((key) => {
          const d = porDimensao[key];
          const score = d.peso ? d.soma / d.peso : 0;
          return { key, nome: DIMENSOES[key].nome, ofertas: DIMENSOES[key].ofertas, score, nivel: nivelDe(score), prioridade: prioridadeDe(score) };
        });
        dimensoesResultado.sort((a, b) => a.score - b.score);

        resultadoCalculado = { maturidadeDigital, controleProcessos, indiceGeral, dimensoesResultado };

        document.getElementById("score-geral").textContent = indiceGeral.toFixed(2);
        document.getElementById("nivel-geral").textContent = nivelDe(indiceGeral);
        document.getElementById("score-digital").textContent = maturidadeDigital.toFixed(2);
        document.getElementById("nivel-digital").textContent = nivelDe(maturidadeDigital);
        document.getElementById("score-processos").textContent = controleProcessos.toFixed(2);
        document.getElementById("nivel-processos").textContent = nivelDe(controleProcessos);

        const listEl = document.getElementById("dim-resultado-list");
        listEl.innerHTML = "";
        dimensoesResultado.forEach((d) => {
          const row = document.createElement("div");
          row.className = "dim-resultado-row";
          row.innerHTML = `
            <div class="dim-resultado-nome">${d.nome}</div>
            <div class="dim-resultado-score">${d.score.toFixed(2)}</div>
            <div class="dim-resultado-nivel">${d.nivel}</div>
            <span class="dim-resultado-prioridade prioridade-${d.prioridade.toLowerCase()}">${d.prioridade}</span>
          `;
          listEl.appendChild(row);
        });

        const lacunas = dimensoesResultado.filter((d) => d.prioridade === "Alta").slice(0, 3);
        const baseLacunas = lacunas.length ? lacunas : dimensoesResultado.slice(0, 2);
        const ofertasSugeridas = new Set();
        baseLacunas.forEach((d) => d.ofertas.forEach((o) => ofertasSugeridas.add(o)));

        const nomesLacunas = baseLacunas.map((d) => d.nome).join(", ");
        document.getElementById("recomendacao-texto").textContent = lacunas.length
          ? `As maiores lacunas hoje estão em ${nomesLacunas}. É por aí que a gente começaria.`
          : `Sua organização já está num bom patamar — ${nomesLacunas} são as frentes com mais espaço pra evoluir.`;

        const chipsEl = document.getElementById("recomendacao-chips");
        chipsEl.innerHTML = "";
        ofertasSugeridas.forEach((nome) => {
          const chip = document.createElement("span");
          chip.className = "recomendacao-chip";
          chip.textContent = nome;
          chipsEl.appendChild(chip);
        });
      }

      // Etapa 2 — captura de contato
      const contatoForm = document.getElementById("diag-contato-form");
      const contatoStatus = document.getElementById("diag-contato-status");
      const contatoSubmit = document.getElementById("diag-contato-submit");

      contatoForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const email = contatoForm.email.value.trim();
        const whatsapp = contatoForm.whatsapp.value.trim();
        if (!email && !whatsapp) {
          contatoStatus.textContent = "Precisamos de pelo menos um e-mail ou WhatsApp pra poder te responder.";
          contatoStatus.className = "form-note is-error";
          return;
        }

        contatoSubmit.disabled = true;
        contatoStatus.textContent = "Enviando...";
        contatoStatus.className = "form-note";

        const r = resultadoCalculado;
        const lacunas = r.dimensoesResultado
          .filter((d) => d.prioridade === "Alta")
          .map((d) => `${d.nome} (${d.score.toFixed(2)})`)
          .join("; ");

        const formData = new FormData(contatoForm);
        formData.set("interesse", state.interesse || "");
        formData.set("indice_geral", r.indiceGeral.toFixed(2));
        formData.set("maturidade_digital", r.maturidadeDigital.toFixed(2));
        formData.set("controle_processos", r.controleProcessos.toFixed(2));
        formData.set("nivel", nivelDe(r.indiceGeral));
        formData.set("lacunas", lacunas);

        try {
          const resp = await fetch("/assessment/leads/diagnostico", { method: "POST", body: formData });
          if (!resp.ok) throw new Error(`status ${resp.status}`);
          contatoForm.reset();
          contatoForm.hidden = true;
          contatoStatus.textContent = "Recebemos seu diagnóstico — a gente entra em contato em breve. Obrigado!";
          contatoStatus.className = "form-note is-ok";
        } catch (err) {
          contatoStatus.textContent = "Não foi possível enviar agora. Tente de novo em instantes.";
          contatoStatus.className = "form-note is-error";
        } finally {
          contatoSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>

