---
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (nome: string) => `${B}/img/${nome}`;

const capacidades = [
  { n: "01", icone: "↻", nome: "Automação de processos", desc: "Redesenhamos tarefas repetitivas e conectamos etapas para reduzir trabalho operacional.", itens: ["Workflows e integrações", "APIs e notificações", "RPA quando faz sentido"], foto: "servico-solucoes.jpg", alt: "Fluxo de trabalho organizado em etapas conectadas" },
  { n: "02", icone: "✳", nome: "Inteligência artificial aplicada", desc: "Usamos IA onde ela produz resultado concreto e se encaixa no trabalho real.", itens: ["Agentes e copilotos", "Leitura inteligente de documentos", "Busca e classificação contextual"], foto: "comp-tecnologia.jpg", alt: "Duas pessoas trabalhando lado a lado em notebooks" },
  { n: "03", icone: "⌘", nome: "Desenvolvimento de software", desc: "Quando a solução pronta não atende, construímos software alinhado ao processo.", itens: ["Aplicações e portais", "Sistemas internos e produtos", "Modernização de aplicações"], foto: "servico-sites.jpg", alt: "Trabalho de desenvolvimento e construção de software" },
  { n: "04", icone: "⌁", nome: "Integração e dados", desc: "Conectamos sistemas e informações para reduzir retrabalho e apoiar decisões.", itens: ["APIs e sincronização", "Dados e dashboards", "Governança da informação"], foto: "pacce-escalas.jpg", alt: "Organização de informações e agenda da equipe" },
  { n: "05", icone: "◉", nome: "Transformação e assessment", desc: "Entendemos processos, sistemas, riscos e maturidade para definir onde investir.", itens: ["Diagnóstico e arquitetura", "Roadmap e governança", "Segurança e modernização"], foto: "comp-consultoria.jpg", alt: "Reunião de análise entre duas pessoas com documentos" },
  { n: "06", icone: "↗", nome: "Experiência e presença digital", desc: "Criamos experiências que aproximam organizações, clientes, equipes e parceiros.", itens: ["Sites e portais", "Jornadas digitais", "Presença institucional"], foto: "servico-marketing.jpg", alt: "Planejamento de presença digital e comunicação" },
];

const problemas = [
  { n: "01", nome: "Processos manuais", desc: "Tarefas repetidas consomem horas que poderiam voltar para o trabalho que importa.", foto: "diagnostico-analise-noturna.jpg", alt: "Análise de indicadores em horário fora do expediente" },
  { n: "02", nome: "Sistemas que não conversam", desc: "A mesma informação é digitada em lugares diferentes — e nunca coincide.", foto: "pacce-prontuario.jpg", alt: "Ficha de cadastro preenchida à mão" },
  { n: "03", nome: "Informação espalhada", desc: "Planilhas, e-mails e sistemas disputam o papel de fonte confiável.", foto: "comp-tecnologia.jpg", alt: "Trabalho em notebooks com informações em vários lugares" },
  { n: "04", nome: "Falta de visibilidade", desc: "A gestão percebe o problema quando ele já começou a afetar a operação.", foto: "servico-marketing.jpg", alt: "Painel de acompanhamento de indicadores" },
  { n: "05", nome: "Software que não acompanha", desc: "A operação se adapta à ferramenta quando deveria acontecer o contrário.", foto: "servico-sites.jpg", alt: "Desenvolvimento de software sob medida" },
  { n: "06", nome: "Conhecimento preso às pessoas", desc: "Quando alguém sai, parte do processo corre o risco de ir junto.", foto: "metodologia-grupo.jpg", alt: "Roda de conversa entre a equipe, compartilhando conhecimento" },
];

const etapasMetodo = [
  { n: "01", nome: "Entender", itens: ["Processo", "Problema", "Pessoas", "Dados e gargalos"], foto: "sobre-acolhimento.jpg", alt: "Conversa atenta — entender antes de propor" },
  { n: "02", nome: "Desenhar", itens: ["Novo fluxo", "Prioridades", "Arquitetura", "Indicadores"], foto: "comp-consultoria.jpg", alt: "Análise de documentos para desenhar o caminho" },
  { n: "03", nome: "Construir", itens: ["Automação", "Software", "Integração", "Inteligência artificial"], foto: "servico-sites.jpg", alt: "Desenvolvimento e construção da solução" },
  { n: "04", nome: "Evoluir", itens: ["Medição", "Suporte", "Aprendizado", "Melhoria contínua"], foto: "diagnostico-analise-noturna.jpg", alt: "Acompanhamento de indicadores após a entrega" },
];

const contextos = [
  { n: "01", nome: "Empresas e operações", desc: "Automação, integração, sistemas internos, dados e transformação digital.", foto: "servico-solucoes.jpg", alt: "Operação de empresa organizada em processos" },
  { n: "02", nome: "Atendimento recorrente", desc: "Operações em que continuidade, histórico e relacionamento fazem parte do trabalho.", foto: "pacce-prontuario.jpg", alt: "Atendimento recorrente com registro de histórico" },
  { n: "03", nome: "Terceiro setor e impacto social", desc: "Governança, pessoas, processos e prestação de contas com clareza operacional.", foto: "sobre-acolhimento.jpg", alt: "Conversa de acolhimento entre duas pessoas" },
  { n: "04", nome: "Organizações em transformação", desc: "Quem cresceu e precisa trocar improvisos por uma arquitetura digital sustentável.", foto: "comp-consultoria.jpg", alt: "Reunião de planejamento para evolução da organização" },
];

const lumenSteps = [
  { n: "01", nome: "Diagnóstico", desc: "Entender o cenário atual" },
  { n: "02", nome: "Priorização", desc: "Escolher o que muda primeiro" },
  { n: "03", nome: "Arquitetura", desc: "Desenhar a solução adequada" },
  { n: "04", nome: "Implementação", desc: "Colocar a mudança em prática" },
  { n: "05", nome: "Medição", desc: "Acompanhar o resultado" },
  { n: "06", nome: "Evolução", desc: "Aprender e melhorar" },
];

const valores = [
  { n: "01", nome: "Visão de negócio", desc: "Tecnologia começa pela operação e pelo resultado que precisa mudar." },
  { n: "02", nome: "Arquitetura", desc: "Soluções pensadas para continuar funcionando quando o projeto termina." },
  { n: "03", nome: "Execução", desc: "Não entregamos apenas recomendações. Construímos e colocamos em prática." },
  { n: "04", nome: "Continuidade", desc: "Medimos, aprendemos e evoluímos junto com o negócio." },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>eloo.digital — Tecnologia para transformar operações</title>
    <meta name="description" content="A eloo.digital transforma operações com tecnologia, automação, inteligência artificial e software sob medida." />
    <link rel="icon" type="image/svg+xml" href={`${B}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="topo" id="topo">
      <a href="#inicio" class="marca" aria-label="eloo.digital, início">eloo<span>.digital</span></a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
      <div class="menu" id="menu">
        <a href="#capacidades">O que fazemos</a>
        <a href="#metodo">Como trabalhamos</a>
        <a href="#solucoes">Soluções</a>
        <a href="#produtos">Produtos</a>
        <a href="#sobre">Sobre</a>
        <a href="/diagnostico" class="menu-cta">Fale com a eloo.digital</a>
      </div>
      <a href="/diagnostico" class="cta-topo">Fale com a eloo.digital</a>
    </nav>

    <main>

      <!-- HERO -->
      <section class="bleed hero-bleed" id="inicio">
        <img class="hero-img" src={img("hero-elo-maos.jpg")} alt="Mãos dadas em círculo, vistas de cima — o elo entre pessoas" />
        <div class="scrim"></div>
        <div class="hero-inner wrap">
          <p class="eyebrow claro">AUTOMAÇÃO · TECNOLOGIA · TRANSFORMAÇÃO DIGITAL</p>
          <h1>Tecnologia para transformar a forma como sua empresa <span class="destaque">trabalha.</span></h1>
          <p class="lede claro">Automatizamos processos, conectamos sistemas, aplicamos inteligência artificial e construímos soluções digitais para reduzir trabalho manual, eliminar gargalos e transformar operações.</p>
          <div class="acoes">
            <a class="btn btn-primario" href="/diagnostico">Quero transformar minha operação ↗</a>
            <a class="btn btn-ghost" href="#solucoes">Conhecer nossas soluções ↓</a>
          </div>
          <div class="prova">
            <b>25</b>
            <span><strong>anos de jornada em tecnologia</strong>, 7 deles dedicados ao acolhimento e à assistência, na linha de frente.</span>
          </div>
        </div>
      </section>

      <!-- VISÃO DA OPERAÇÃO -->
      <section class="bleed escuro" id="visao">
        <img class="bleed-foto" src={img("pacce-escalas.jpg")} alt="Organização de agenda e processos da equipe" loading="lazy" />
        <div class="bleed-texto">
          <p class="eyebrow claro">Visão da operação</p>
          <h2>Pessoas, processos, informação e tecnologia, <span class="destaque">conectados.</span></h2>
          <p class="lede claro">Uma operação se move quando esses quatro pontos conversam. Quando um deles fica para trás, o resto paga o preço.</p>
          <figure class="visao-diagrama" aria-label="Diagrama de pessoas, processos, informação e tecnologia conectados em torno da operação">
            <svg viewBox="0 0 700 700" role="img">
              <circle cx="350" cy="350" r="250" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.5"/>
              <circle cx="350" cy="350" r="150" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="1.2" stroke-dasharray="4 6"/>
              <circle cx="350" cy="350" r="92" fill="#e0201a"/>
              <text x="350" y="318" text-anchor="middle" font-size="34" fill="#fff3f2">✳</text>
              <text x="350" y="366" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="22" font-weight="700" fill="#ffffff">operação</text>
              <text x="350" y="392" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="13" fill="rgba(255,255,255,.85)">em evolução</text>
              <g>
                <rect x="235" y="30" width="230" height="110" rx="16" fill="#2a2a27" stroke="#3a3a36"/>
                <text x="260" y="70" font-family="IBM Plex Sans, sans-serif" font-size="12" font-weight="700" fill="#ff8a84">01</text>
                <text x="260" y="100" font-family="Bricolage Grotesque, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Pessoas</text>
                <text x="260" y="124" font-family="IBM Plex Sans, sans-serif" font-size="14" fill="rgba(255,255,255,.7)">decidem melhor</text>
              </g>
              <g>
                <rect x="470" y="295" width="200" height="110" rx="16" fill="#2a2a27" stroke="#3a3a36"/>
                <text x="495" y="335" font-family="IBM Plex Sans, sans-serif" font-size="12" font-weight="700" fill="#ff8a84">02</text>
                <text x="495" y="365" font-family="Bricolage Grotesque, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Processos</text>
                <text x="495" y="389" font-family="IBM Plex Sans, sans-serif" font-size="14" fill="rgba(255,255,255,.7)">fluem sem atrito</text>
              </g>
              <g>
                <rect x="235" y="560" width="230" height="110" rx="16" fill="#2a2a27" stroke="#3a3a36"/>
                <text x="260" y="600" font-family="IBM Plex Sans, sans-serif" font-size="12" font-weight="700" fill="#ff8a84">03</text>
                <text x="260" y="630" font-family="Bricolage Grotesque, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Informação</text>
                <text x="260" y="654" font-family="IBM Plex Sans, sans-serif" font-size="14" fill="rgba(255,255,255,.7)">conectada</text>
              </g>
              <g>
                <rect x="20" y="295" width="200" height="110" rx="16" fill="#2a2a27" stroke="#3a3a36"/>
                <text x="45" y="335" font-family="IBM Plex Sans, sans-serif" font-size="12" font-weight="700" fill="#ff8a84">04</text>
                <text x="45" y="365" font-family="Bricolage Grotesque, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Tecnologia</text>
                <text x="45" y="389" font-family="IBM Plex Sans, sans-serif" font-size="14" fill="rgba(255,255,255,.7)">em contexto</text>
              </g>
            </svg>
          </figure>
          <p class="rodape-texto claro">Uma operação. Muitas possibilidades.</p>
        </div>
      </section>

      <!-- PROBLEMA -->
      <section class="secao" id="problema">
        <div class="wrap">
          <div class="cabeca">
            <p class="eyebrow">O CENÁRIO QUE CONHECEMOS</p>
            <h2>Tecnologia não deveria criar <span class="destaque-ink">mais trabalho.</span></h2>
            <p class="intro">Muitas empresas cresceram acumulando planilhas, sistemas isolados, tarefas repetitivas e informação espalhada. A eloo.digital entra justamente nesse ponto.</p>
          </div>
          <div class="grid-3">
            {problemas.map((p) => (
              <article class="card-foto">
                <div class="card-foto-img"><img src={img(p.foto)} alt={p.alt} loading="lazy" /><span class="num">{p.n}</span></div>
                <div class="card-foto-corpo"><h3>{p.nome}</h3><p>{p.desc}</p></div>
              </article>
            ))}
          </div>
          <p class="fecho"><b>↗</b> Transformamos esse cenário em processos digitais <strong>mais simples, conectados, automatizados e mensuráveis.</strong></p>
        </div>
      </section>

      <!-- CAPACIDADES -->
      <section class="secao escuro" id="capacidades">
        <div class="wrap">
          <div class="cabeca claro">
            <p class="eyebrow">O QUE FAZEMOS</p>
            <h2>Tecnologia aplicada ao <span class="destaque">problema certo.</span></h2>
            <p class="intro">Entendemos o desafio e combinamos as capacidades certas para transformar a operação.</p>
          </div>
          <div class="grid-3">
            {capacidades.map((c) => (
              <article class="card-foto card-escuro">
                <div class="card-foto-img"><img src={img(c.foto)} alt={c.alt} loading="lazy" /><span class="num">{c.n}</span></div>
                <div class="card-foto-corpo">
                  <h3><span class="icone">{c.icone}</span> {c.nome}</h3>
                  <p>{c.desc}</p>
                  <ul>{c.itens.map((i) => <li>{i}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- MÉTODO -->
      <section class="bleed" id="metodo">
        <img class="bleed-foto" src={img("metodologia-grupo.jpg")} alt="Roda de conversa — entender antes de desenhar a solução" loading="lazy" />
        <div class="bleed-texto">
          <p class="eyebrow">NOSSO JEITO DE TRABALHAR</p>
          <h2>Não começamos perguntando qual sistema você quer.</h2>
          <p class="lede">Começamos entendendo <em>o que precisa mudar.</em></p>
        </div>
      </section>
      <section class="secao-faixa">
        <div class="wrap grid-4">
          {etapasMetodo.map((e) => (
            <article class="card-foto">
              <div class="card-foto-img"><img src={img(e.foto)} alt={e.alt} loading="lazy" /><span class="num">{e.n}</span></div>
              <div class="card-foto-corpo">
                <h3>{e.nome}</h3>
                <ul class="lista-etapa">{e.itens.map((i) => <li>{i}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <div class="wrap nota-faixa">
          <p><strong>O trabalho não termina na entrega.</strong> Medimos o que mudou e evoluímos a solução junto com a operação.</p>
          <a class="btn btn-primario" href="#metodologia">Conheça a metodologia LUMEN ↗</a>
        </div>
      </section>

      <!-- AUTOMAÇÃO -->
      <section class="bleed escuro bleed-reverso" id="automacao">
        <img class="bleed-foto" src={img("comp-tecnologia.jpg")} alt="Trabalho com tecnologia em equipe" loading="lazy" />
        <div class="bleed-texto">
          <p class="eyebrow">AUTOMAÇÃO</p>
          <h2>Se alguém repete a mesma tarefa todo dia, vale perguntar se uma máquina deveria <span class="destaque">fazer parte dela.</span></h2>
          <p class="lede">Automatizar não é simplesmente substituir pessoas. É devolver à equipe o tempo para decisões e atividades em que ela gera valor.</p>
          <a class="link-texto" href="/diagnostico">Vamos mapear a sua operação ↗</a>
        </div>
      </section>
      <section class="secao-faixa">
        <div class="wrap">
          <div class="cabeca">
            <p class="eyebrow">O ANTES E O DEPOIS</p>
            <h2>Da rotina manual ao <span class="destaque-ink">fluxo conectado.</span></h2>
            <p class="intro">O mesmo trabalho, com menos cópias, menos erro e mais tempo para a equipe decidir.</p>
          </div>
          <div class="fluxo">
            <article class="card-foto antes-card">
              <div class="card-foto-img"><img src={img("pacce-prontuario.jpg")} alt="Ficha de cadastro preenchida à mão — o trabalho manual de hoje" loading="lazy" /><span class="num tag-antes">ANTES</span></div>
              <div class="card-foto-corpo">
                <h3>Rotina manual</h3>
                <ol class="passos">
                  <li>Pedido chega por e-mail</li>
                  <li>Pessoa copia informações</li>
                  <li>Atualiza planilha</li>
                  <li>Repete em outro sistema</li>
                  <li>Envia mensagem e atualiza status</li>
                </ol>
              </div>
            </article>
            <div class="conector" aria-hidden="true"><span>→</span></div>
            <article class="card-foto depois-card">
              <div class="card-foto-img"><img src={img("servico-solucoes.jpg")} alt="Fluxo de trabalho organizado e conectado" loading="lazy" /><span class="num tag-depois">DEPOIS</span></div>
              <div class="card-foto-corpo">
                <h3>Fluxo conectado</h3>
                <ol class="passos">
                  <li>Um evento acontece</li>
                  <li>Informação é interpretada</li>
                  <li>Sistemas são atualizados</li>
                  <li>Regras são executadas</li>
                  <li>Equipe recebe contexto e indicadores</li>
                </ol>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- IA -->
      <section class="bleed" id="ia">
        <img class="bleed-foto" src={img("comp-fluencia.jpg")} alt="Conversa de acolhimento — a IA entra onde há processo real" loading="lazy" />
        <div class="bleed-texto">
          <p class="eyebrow">INTELIGÊNCIA ARTIFICIAL</p>
          <h2>IA faz sentido quando deixa de ser demonstração e <span class="destaque-ink">vira processo.</span></h2>
          <p class="lede">Integramos modelos de inteligência artificial às operações para interpretar informação, apoiar decisões e automatizar atividades que antes dependiam exclusivamente de trabalho manual.</p>
          <div class="tags">
            <span>Leitura de documentos</span><span>Conhecimento interno</span><span>Copilotos e agentes</span>
            <span>Análise de informação</span><span>Triagem e atendimento</span><span>Conteúdo estruturado</span>
          </div>
          <small class="rodape-texto">Cada uso parte do contexto, dos dados disponíveis e do resultado esperado.</small>
        </div>
      </section>

      <!-- PRODUTOS -->
      <section class="escuro" id="produtos">
        <div class="wrap produto">
          <div class="produto-texto">
            <div class="produto-marca"><b>p</b><span><strong>PACCE</strong><small>Um produto eloo.digital</small></span></div>
            <p class="eyebrow">TECNOLOGIA PARA ATENDIMENTO RECORRENTE</p>
            <h2>Gestão e atendimento organizados em <span class="destaque">uma única plataforma.</span></h2>
            <p class="lede claro">O PACCE nasceu da experiência da eloo.digital com organizações que realizam atendimento recorrente e precisam organizar pessoas, cadastros, históricos, equipes, filas e processos sem depender de planilhas dispersas.</p>
            <div class="pills">
              <span>Cadastro</span><span>Atendimento</span><span>Histórico</span><span>Equipes e escalas</span><span>Governança</span>
            </div>
            <a class="btn btn-primario" href="/pacce">Conhecer o PACCE ↗</a>
          </div>
          <div class="produto-foto">
            <img src={img("pacce-exemplo.svg")} alt="Ilustração de tela do PACCE com dados de exemplo" loading="lazy" />
            <p>PACCE é um produto da <strong>eloo.digital</strong></p>
          </div>
        </div>
      </section>

      <!-- SOLUÇÕES POR CONTEXTO -->
      <section class="secao" id="solucoes">
        <div class="wrap">
          <div class="cabeca">
            <p class="eyebrow">SOLUÇÕES POR CONTEXTO</p>
            <h2>Tecnologia horizontal. <span class="destaque-ink">Conhecimento especializado quando precisa.</span></h2>
            <p class="intro">A mesma capacidade de transformar operações, aplicada às particularidades de cada organização.</p>
          </div>
          <div class="grid-4">
            {contextos.map((c) => (
              <article class="card-foto">
                <div class="card-foto-img"><img src={img(c.foto)} alt={c.alt} loading="lazy" /><span class="num">{c.n}</span></div>
                <div class="card-foto-corpo"><h3>{c.nome}</h3><p>{c.desc}</p><a href="/diagnostico" aria-label={`Conversar sobre ${c.nome}`}>Conversar ↗</a></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- METODOLOGIA LUMEN -->
      <section class="vermelho" id="metodologia">
        <div class="wrap lumen">
          <div class="lumen-texto">
            <p class="eyebrow claro">METODOLOGIA LUMEN</p>
            <h2>Antes da solução, <span class="destaque">clareza sobre o problema.</span></h2>
            <p class="lede claro">A LUMEN estrutura a análise da operação, tecnologia, processos, riscos e oportunidades para transformar questões difusas em um plano de evolução executável.</p>
            <a class="btn btn-claro" href="/diagnostico">Faça um diagnóstico ↗</a>
          </div>
          <div class="lumen-passos">
            {lumenSteps.map((s) => (
              <div><span>{s.n}</span><b>{s.nome}</b><small>{s.desc}</small></div>
            ))}
          </div>
        </div>
      </section>

      <!-- DIAGNÓSTICO (CTA para o diagnóstico real, que grava o lead no CRM) -->
      <section class="bleed" id="diagnostico">
        <img class="bleed-foto" src={img("diagnostico-analise-noturna.jpg")} alt="Análise de indicadores da operação com atenção aos detalhes" loading="lazy" />
        <div class="bleed-texto">
