---
// Página do PACCE no padrão full-bleed editorial da v2 (index.astro):
// mesmas fontes, tokens, topo e rodapé. Público: quem coordena
// atendimento recorrente (acolhimento, organizações sociais, clínicas e
// centros de cuidado). Ver PRODUCT.md e DESIGN.md na raiz.
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (nome: string) => `${B}/img/${nome}`;

const dores = [
  "O histórico se perde na troca de turno.",
  "A escala é montada no grupo de WhatsApp.",
  "O relatório é feito na véspera da reunião.",
];

const modulos = [
  "Cadastro de pessoas atendidas", "Atendimento por tipo", "Histórico", "Agenda",
  "Turnos e escalas", "Equipes e funções", "Fluxo de etapas", "Perfis de acesso",
  "Registro de atividades", "Indicadores",
];

const recursos = [
  {
    id: "cadastro",
    titulo: "Cadastro e histórico que acompanham a pessoa",
    texto: "Quem chega é cadastrado uma vez. Cada atendimento, orientação e encaminhamento entra no histórico, e quem atende na próxima vez já sabe por onde começar.",
    itens: ["Busca por nome, CPF ou e-mail", "Contatos de emergência", "Data de retorno", "Tipos de atendimento definidos por vocês"],
    foto: "sobre-acolhimento.jpg",
    alt: "Duas pessoas conversando de perto, em um atendimento de escuta",
  },
  {
    id: "escalas",
    titulo: "Escalas da equipe sem buraco",
    texto: "Turnos de funcionários, plantonistas e voluntários num quadro só. Dá para ver quem está escalado e onde falta gente antes de o dia começar.",
    itens: ["Turnos e funções", "Equipes por departamento", "Agenda de atendimentos"],
    foto: "pacce-escalas.jpg",
    alt: "Agenda e quadro de turnos da equipe organizados sobre a mesa",
  },
  {
    id: "fluxo",
    titulo: "O atendimento do jeito que vocês já trabalham",
    texto: "Cada organização define as etapas do próprio atendimento: acolhimento, triagem, retorno, encaminhamento. O PACCE segue esse fluxo, em vez de obrigar a equipe a mudar a rotina para caber no sistema.",
    itens: ["Construtor de etapas", "Departamentos e tipos configuráveis", "Avisos para a equipe"],
    foto: "comp-tecnologia.jpg",
    alt: "Duas pessoas trabalhando lado a lado em notebooks",
  },
  {
    id: "seguranca",
    titulo: "Dados protegidos e contas claras",
    texto: "Cada pessoa da equipe vê só o que o perfil dela permite, e o que é feito fica registrado. Na hora de prestar contas à diretoria, aos financiadores ou à assembleia, os números já estão lá.",
    itens: ["Perfis de acesso por função", "Registro de atividades", "Consentimento do atendido registrado", "Indicadores e relatórios"],
    foto: "pacce-seguranca.jpg",
    alt: "Pessoa trabalhando com atenção em informações protegidas",
  },
];

const maturidade = [
  { nome: "Manual", hoje: "Papel, memória e conversa informal.", com: "Cadastro e histórico digitalizados em um lugar só." },
  { nome: "Parcial", hoje: "Planilhas soltas que dependem de quem fez.", com: "Setores e equipes trabalhando na mesma base." },
  { nome: "Frágil", hoje: "Sistema antigo, sem suporte ou sem dono.", com: "Plataforma mantida, com evolução contínua." },
  { nome: "Estruturado", hoje: "Processo que resiste à troca de equipe.", com: "Onde o PACCE consolida a operação." },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PACCE — gestão de atendimento recorrente | eloo.digital</title>
    <meta name="description" content="PACCE, da eloo.digital: cadastro, atendimento, histórico, agenda e escalas da equipe em uma só plataforma, para quem faz atendimento recorrente." />
    <link rel="icon" type="image/svg+xml" href={`${B}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="topo" id="topo">
      <a href="/" class="marca" aria-label="eloo.digital, página inicial">eloo<span>.digital</span></a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
      <div class="menu" id="menu">
        <a href="/#capacidades">O que fazemos</a>
        <a href="#por-dentro">O PACCE por dentro</a>
        <a href="#recursos">Recursos</a>
        <a href="#producao">Em produção</a>
        <a href="/diagnostico" class="menu-cta">Fazer o diagnóstico</a>
      </div>
      <a href="/diagnostico" class="cta-topo">Fazer o diagnóstico</a>
    </nav>

    <main>

      <!-- HERO -->
      <section class="hero" id="inicio">
        <img class="hero-img" src={img("pacce-prontuario.jpg")} alt="Ficha de cadastro preenchida à mão, como ainda acontece em muitas organizações" />
        <div class="scrim"></div>
        <div class="hero-inner wrap">
          <div class="selo"><b>p</b><span><strong>PACCE</strong><small>um produto eloo.digital</small></span></div>
          <h1>Cada pessoa atendida tem uma história. <span class="destaque">O PACCE não deixa ela se perder.</span></h1>
          <p class="lede claro">Cadastro, atendimento, histórico, agenda e escalas da equipe em uma plataforma só, para quem atende as mesmas pessoas semana após semana.</p>
          <div class="acoes">
            <a class="btn btn-primario" href="/diagnostico">Fazer o diagnóstico ↗</a>
            <a class="btn btn-ghost" href="#por-dentro">Ver o PACCE por dentro ↓</a>
          </div>
          <ul class="hero-fatos" aria-label="Fatos sobre o PACCE">
            <li><b>Em produção</b> no ar em pacce.app</li>
            <li><b>Várias organizações</b> na mesma plataforma, cada uma com seus dados</li>
            <li><b>Acesso por perfil</b> e registro de tudo o que é feito</li>
          </ul>
        </div>
      </section>

      <!-- DECLARAÇÃO -->
      <section class="declaracao vermelho">
        <div class="wrap">
          <h2>Quem atende gente todo dia não pode depender de papel, planilha e mensagem solta.</h2>
          <ol class="dores">
            {dores.map((d) => <li>{d}</li>)}
          </ol>
          <p class="declaracao-fecho">O PACCE foi desenhado por quem passou 7 anos na linha de frente de organizações de atendimento, dentro de 25 anos de tecnologia.</p>
        </div>
      </section>

      <!-- POR DENTRO -->
      <section class="por-dentro escuro" id="por-dentro">
        <div class="wrap por-dentro-grid">
          <div class="por-dentro-texto">
            <h2>Uma tela para o dia de atendimento, <span class="destaque">do primeiro contato ao retorno.</span></h2>
            <p class="lede claro">A equipe abre o PACCE e vê quem está na fila, que tipo de atendimento cada pessoa precisa e quem está escalado. A coordenação vê o todo: volume do dia, retornos pendentes e onde a operação aperta.</p>
            <ul class="modulos" aria-label="Módulos do PACCE">
              {modulos.map((m) => <li>{m}</li>)}
            </ul>
          </div>
          <figure class="tela">
            <div class="tela-barra" aria-hidden="true"><i></i><i></i><i></i><span>pacce.app</span></div>
            <img src={img("pacce-exemplo.svg")} alt="Tela de atendimentos do PACCE com dados de exemplo: tipos de atendimento do dia e fila de pessoas" loading="lazy" />
            <figcaption>Tela com dados de exemplo.</figcaption>
          </figure>
        </div>
      </section>

      <!-- RECURSOS (faixas full-bleed alternadas) -->
      <div id="recursos">
        {recursos.map((r, i) => (
          <section class={`bleed ${i % 2 ? "bleed-reverso" : ""} ${i === 3 ? "escuro" : ""}`} id={r.id}>
            <img class="bleed-foto" src={img(r.foto)} alt={r.alt} loading="lazy" />
            <div class="bleed-texto">
              <h2>{r.titulo}</h2>
              <p class={`lede ${i === 3 ? "claro" : ""}`}>{r.texto}</p>
              <ul class="lista-recurso">
                {r.itens.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          </section>
        ))}
      </div>

      <!-- EM PRODUÇÃO -->
      <section class="producao" id="producao">
        <div class="wrap producao-grid">
          <figure class="tela tela-clara">
            <div class="tela-barra" aria-hidden="true"><i></i><i></i><i></i><span>pacce.app</span></div>
            <img src={img("pacce-painel-real.png")} alt="Painel real do PACCE: atendimentos de hoje, em andamento, finalizados e gráfico de desempenho da semana" loading="lazy" />
            <figcaption>Painel real, em produção.</figcaption>
          </figure>
          <div class="producao-texto">
            <h2>Não é protótipo. <span class="destaque-ink">Já está no ar.</span></h2>
            <p class="lede">A tela ao lado é o painel do PACCE em produção: atendimentos do dia, em andamento, finalizados e o desempenho da semana, por departamento.</p>
            <dl class="fatos">
              <div><dt>Entrada</dt><dd>Login com e-mail, Google ou Microsoft.</dd></div>
              <div><dt>Organizações</dt><dd>Cada instituição com seus dados, usuários e configurações.</dd></div>
              <div><dt>Próximos módulos</dt><dd>Campanhas nas redes sociais e financeiro com balancete mensal.</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- MATURIDADE (LUMEN) -->
      <section class="maturidade escuro" id="maturidade">
        <div class="wrap">
          <div class="maturidade-cabeca">
            <h2>Em que ponto está a sua operação <span class="destaque">hoje?</span></h2>
            <p class="lede claro">A metodologia LUMEN da eloo.digital mede a maturidade da operação em quatro níveis. O PACCE é o que leva cada nível ao seguinte.</p>
          </div>
          <ol class="regua">
            {maturidade.map((m, i) => (
              <li>
                <span class="regua-nivel">Nível {i + 1}</span>
                <h3>{m.nome}</h3>
                <p class="regua-hoje">{m.hoje}</p>
                <p class="regua-com"><b>Com o PACCE</b>{m.com}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="cta-foto" id="contato">
        <img class="cta-img" src={img("reiki-acolhimento.jpg")} alt="Mãos em gesto de cuidado durante um atendimento" loading="lazy" />
        <div class="scrim scrim-total"></div>
        <div class="wrap cta-inner">
          <p class="tempo">≈ 3 minutos</p>
          <h2>Comece pelo diagnóstico. <span class="destaque">A plataforma vem depois.</span></h2>
          <p class="lede claro">Responda como a sua operação funciona hoje. Mostramos onde o PACCE ajuda primeiro e, se quiser, a equipe da eloo.digital volta com a análise.</p>
          <div class="acoes centro">
            <a class="btn btn-primario" href="/diagnostico">Fazer o diagnóstico ↗</a>
            <a class="btn btn-ghost" href="/">Conhecer a eloo.digital</a>
          </div>
        </div>
      </section>

    </main>

    <footer class="rodape">
      <div class="wrap rodape-grid">
        <div>
          <a href="/" class="marca">eloo<span>.digital</span></a>
          <p>Tecnologia para transformar operações.</p>
        </div>
        <div>
          <b>Empresa</b>
          <a href="/#sobre">Sobre</a><a href="/#metodologia">Metodologia</a><a href="/diagnostico">Contato</a>
        </div>
        <div>
          <b>O que fazemos</b>
          <a href="/#automacao">Automação</a><a href="/#ia">Inteligência artificial</a><a href="/#capacidades">Desenvolvimento e integrações</a><a href="/#capacidades">Transformação digital</a><a href="/assessment">Assessment de TI</a>
        </div>
        <div>
          <b>Produtos</b>
          <a href="/pacce" aria-current="page">PACCE</a>
        </div>
      </div>
      <div class="wrap rodape-base">
        <span>© eloo.digital</span>
        <span>PACCE é um produto da eloo.digital.</span>
        <a href="#topo">Voltar ao topo ↑</a>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("menu-btn");
      const menu = document.getElementById("menu");
      btn.addEventListener("click", () => {
        const aberto = menu.classList.toggle("aberto");
        btn.classList.toggle("aberto", aberto);
        btn.setAttribute("aria-expanded", String(aberto));
      });
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
        menu.classList.remove("aberto"); btn.classList.remove("aberto"); btn.setAttribute("aria-expanded", "false");
      }));
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #f4f2ed;
    --bg-alt: #e6e4dd;
    --card: #fbfaf7;
    --ink: #1f1f1d;
    --ink-soft: #55554f;
    --line: #d8d6ce;
    --accent: #e0201a;
    --accent-deep: #b8160f;
    --accent-ink: #fff3f2;
    --escuro: #1f1f1d;
    --destaque-escuro: #ff8a84;
    --font-title: 'Bricolage Grotesque', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --ease: cubic-bezier(.16, 1, .3, 1);
    --z-topo: 20;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.6; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  h1, h2, h3 { font-family: var(--font-title); letter-spacing: -0.015em; text-wrap: balance; margin: 0; }
  p { margin: 0 0 1rem; text-wrap: pretty; }
  ul, ol { margin: 0; }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.4rem; }
  .destaque { color: var(--destaque-escuro); }
  .destaque-ink { color: var(--accent); }
  .lede { font-size: 1.08rem; color: var(--ink-soft); max-width: 60ch; }
  .lede.claro, .claro { color: rgba(255, 255, 255, .86); }
  .escuro { background: var(--escuro); color: #fff; }
  .escuro h2, .escuro h3 { color: #fff; }
  .vermelho { background: var(--accent); color: var(--accent-ink); }

  /* Botões */
  .btn { display: inline-flex; align-items: center; gap: .4rem; border-radius: 999px; padding: .9rem 1.55rem; font-family: var(--font-title); font-weight: 700; font-size: .96rem; text-decoration: none; border: 1px solid transparent; transition: background .2s ease, transform .3s var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  .btn:focus-visible, .menu a:focus-visible, .cta-topo:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .btn-primario { background: var(--accent); color: var(--accent-ink); }
  .btn-primario:hover { background: var(--accent-deep); }
  .btn-ghost { background: transparent; color: #fff; border-color: rgba(255, 255, 255, .6); }
  .btn-ghost:hover { border-color: #fff; }
  .acoes { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .acoes.centro { justify-content: center; }

  /* Topo (igual à home) */
  .topo { position: sticky; top: 0; z-index: var(--z-topo); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1.4rem; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .marca { font-family: var(--font-title); font-weight: 800; font-size: 1.15rem; text-decoration: none; color: var(--ink); }
  .marca span { font-weight: 500; color: var(--ink-soft); }
  .menu { display: flex; gap: 1.5rem; font-size: .9rem; font-weight: 600; }
  .menu a { text-decoration: none; color: var(--ink-soft); }
  .menu a:hover { color: var(--accent); }
  .cta-topo { background: var(--accent); color: var(--accent-ink); border-radius: 999px; padding: .55rem 1.1rem; font-size: .85rem; font-weight: 700; text-decoration: none; }
  section[id], #recursos { scroll-margin-top: 4.5rem; }
  .menu-cta { display: none; }
  .menu-btn { display: none; background: none; border: none; width: 2.2rem; height: 2.2rem; flex-direction: column; justify-content: center; align-items: flex-end; gap: 5px; padding: 0; cursor: pointer; }
  .menu-btn span { display: block; width: 100%; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .25s ease, opacity .25s ease; }
  .menu-btn.aberto span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn.aberto span:nth-child(2) { opacity: 0; }
  .menu-btn.aberto span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .cta-topo { display: none; }
    .menu { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 1.1rem; background: var(--card); border-bottom: 1px solid var(--line); padding: 1.5rem 1.4rem 2rem; box-shadow: 0 16px 32px rgba(0, 0, 0, .12); }
    .menu.aberto { display: flex; }
    .menu-cta { display: block; color: var(--accent); }
  }

  /* Hero full-bleed */
  .hero { position: relative; min-height: min(92vh, 800px); color: #fff; overflow: hidden; display: flex; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20, 20, 18, .94) 0%, rgba(20, 20, 18, .72) 42%, rgba(20, 20, 18, .3) 75%, rgba(20, 20, 18, .12) 100%); }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-top: 7rem; padding-bottom: 3.5rem; width: 100%; }
  .selo { display: flex; align-items: center; gap: .7rem; margin-bottom: 1.6rem; }
  .selo b { width: 2.6rem; height: 2.6rem; border-radius: 11px; background: var(--accent); color: #fff; display: grid; place-items: center; font-family: var(--font-title); font-size: 1.2rem; }
  .selo strong { display: block; font-family: var(--font-title); font-size: 1.15rem; letter-spacing: .02em; line-height: 1.2; }
  .selo small { display: block; font-size: .8rem; color: rgba(255, 255, 255, .75); }
  .hero h1 { font-size: clamp(2.3rem, 5.6vw, 4.4rem); line-height: 1.04; max-width: 17ch; color: #fff; margin-bottom: 1.3rem; }
  .hero .lede { font-size: 1.15rem; max-width: 52ch; }
  .hero-fatos { list-style: none; padding: 1.4rem 0 0; margin: 2.6rem 0 0; border-top: 1px solid rgba(255, 255, 255, .22); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; font-size: .92rem; color: rgba(255, 255, 255, .8); max-width: 900px; }
  .hero-fatos b { display: block; font-family: var(--font-title); font-size: 1.05rem; color: #fff; }
  @media (max-width: 720px) {
    .hero-fatos { grid-template-columns: 1fr; gap: .9rem; }
    .hero .scrim { background: linear-gradient(0deg, rgba(20, 20, 18, .95) 0%, rgba(20, 20, 18, .8) 60%, rgba(20, 20, 18, .45) 100%); }
  }

  /* Declaração em vermelho */
  .declaracao { padding: clamp(4.5rem, 9vw, 7.5rem) 0; }
  .declaracao h2 { font-size: clamp(2rem, 4.6vw, 3.5rem); line-height: 1.08; max-width: 20ch; color: var(--accent-ink); }
  .dores { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255, 243, 242, .35); }
  .dores li { font-family: var(--font-title); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 600; line-height: 1.25; padding: 1.4rem 1.6rem 0 0; }
  .dores li + li { padding-left: 1.6rem; border-left: 1px solid rgba(255, 243, 242, .35); }
  .declaracao-fecho { margin: 3rem 0 0; font-size: 1.02rem; max-width: 56ch; color: color-mix(in srgb, var(--accent-ink) 92%, transparent); }
  @media (max-width: 760px) {
    .dores { grid-template-columns: 1fr; }
    .dores li, .dores li + li { padding: 1.1rem 0; border-left: none; border-bottom: 1px solid rgba(255, 243, 242, .35); }
  }

  /* Por dentro */
  .por-dentro { padding: clamp(4.5rem, 8vw, 7rem) 0; overflow: hidden; }
  .por-dentro-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .por-dentro h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.1; margin-bottom: 1.2rem; }
  .modulos { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .modulos li { border: 1px solid rgba(255, 255, 255, .28); border-radius: 999px; padding: .35rem .9rem; font-size: .86rem; color: #fff; }
  .tela { margin: 0; background: #151514; border-radius: 18px; padding: .7rem .7rem 0; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .7); transform: rotate(-1deg); }
  .tela-barra { display: flex; align-items: center; gap: .4rem; padding: .2rem .4rem .7rem; }
  .tela-barra i { width: .62rem; height: .62rem; border-radius: 50%; background: #3a3a36; }
  .tela-barra span { margin-left: .6rem; font-size: .75rem; color: rgba(255, 255, 255, .6); }
  .tela img { border-radius: 10px 10px 0 0; width: 100%; }
  .tela figcaption { font-size: .78rem; color: rgba(255, 255, 255, .6); padding: .7rem .4rem .8rem; }
  @media (max-width: 900px) { .por-dentro-grid { grid-template-columns: 1fr; } .tela { transform: none; } }

  /* Faixas full-bleed de recursos */
  .bleed { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: min(78vh, 640px); background: var(--bg); }
  .bleed.escuro { background: var(--escuro); }
  .bleed + .bleed:not(.escuro) { border-top: 1px solid var(--line); }
